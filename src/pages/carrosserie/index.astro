---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SpaceLayout from '../../layouts/SpaceLayout.astro';
import PhotoRail from '../../components/PhotoRail.astro';
import StepsList from '../../components/StepsList.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import type { LogoItem } from '../../components/LogoMarquee.astro';
import AccessBlock from '../../components/AccessBlock.astro';
import Atouts from '../../components/Atouts.astro';
import FranchiseBadge from '../../components/FranchiseBadge.astro';
import ServiceBento from '../../components/ServiceBento.astro';
import { heroCarrosserie as hero } from '../../lib/hero';
import partners from '../../data/partners.json';
import { makes } from '../../lib/brands';
import { carroHome } from '../../lib/carrosserie';
import { carroItems } from '../../lib/cards';

const partnerFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/partners/*.webp', { eager: true });
const insurers: LogoItem[] = partners
  .filter((p) => p.featured)
  .map((p) => {
    const img = partnerFiles[`../../assets/partners/${p.file}`].default;
    return { name: p.name, src: img.src, width: img.width, height: img.height };
  });
---
<SpaceLayout
  space="carrosserie"
  title="Carrosserie à Bischheim — Réparation, peinture, assurance | WCC"
  description="Choc, rayure, bosse, grêle, pare-brise : réparation de carrosserie et peinture à Bischheim, toutes marques. Aide pour vos démarches d’assurance, devis sur demande."
>
  <section class="hero">
    <Image src={hero} alt="" widths={[640, 1000, 1400, 1920]} sizes="100vw" format="webp" quality={72} loading="eager" fetchpriority="high" />
    <div class="hero-in">
      <FranchiseBadge class="hero-promo" />
      <p class="label">Carrosserie à Bischheim</p>
      <h1>Un choc, une rayure ?<br />Une solution.</h1>
      <p class="sub">Réparation, peinture et accompagnement dans vos démarches d’assurance.</p>
      <div class="actions">
        <a class="pill" href="#situation">Quel est votre problème ? <i><svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></i></a>
        <a class="ghost" href="/carrosserie/contact/">Demander un devis</a>
      </div>
    </div>
  </section>
  <Atouts />

  <section class="section" id="situation" aria-labelledby="situation-t">
    <div class="wrap">
      <p class="label muted reveal">Votre situation</p>
      <h2 id="situation-t" class="big reveal">Que s’est-il<br />passé ?</h2>
      <div class="reveal"><PhotoRail items={carroItems} accent="orange" label="Situations et interventions de carrosserie" /></div>
      <p class="note reveal">Chaque dommage est différent : nous n’affichons pas de prix d’appel en carrosserie. Le devis est établi à partir de votre demande.</p>
    </div>
  </section>

  <section class="ins" id="assurances" aria-labelledby="ins-t">
    <div class="wrap ins-in">
      <div class="reveal">
        <p class="label muted">Assurance</p>
        <h2 id="ins-t" class="big">Nous vous<br />accompagnons.</h2>
      </div>
      <div class="reveal" style="--d:.1s">
        <p>Votre véhicule est accidenté : nous vous aidons dans vos démarches avec votre assureur, de la description du dommage au suivi du dossier.</p>
        <a class="all" href="/carrosserie/assurances/">Voir le déroulement d’un dossier <svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></a>
      </div>
    </div>
    <div class="ticker">
      <LogoMarquee label="Partenaires assurance" items={insurers} accent="orange" moreHref="/carrosserie/assurances/" moreLabel="Voir tous nos partenaires" duration={52} />
    </div>
  </section>

  <section class="section" aria-labelledby="deroule">
    <div class="wrap">
      <div class="reveal">
        <StepsList steps={carroHome.steps} accent="orange" cta={{ href: '/carrosserie/contact/', label: 'Demander un devis' }}>
          <Fragment slot="head">
            <p class="label">Déroulement</p>
            <h2 id="deroule" class="big">Simple,<br />étape par étape.</h2>
          </Fragment>
        </StepsList>
      </div>
    </div>
  </section>

  <section class="section alt" id="a-votre-service" aria-labelledby="avantages">
    <div class="wrap">
      <div class="adv-head">
        <div>
          <p class="label muted reveal">Ce que nous vous proposons</p>
          <h2 id="avantages" class="big reveal">À votre<br />service.</h2>
        </div>
        <p class="adv-lead reveal" style="--d:.1s">Un accompagnement du premier contact à la restitution : vous restez mobile pendant la réparation et vous retrouvez un véhicule propre.</p>
      </div>
      <ServiceBento />
    </div>
  </section>

  <section class="multi" aria-labelledby="multi-t">
    <div class="wrap multi-in">
      <div class="reveal">
        <p class="label muted">Multimarque</p>
        <h2 id="multi-t" class="big">Toutes marques,<br />une même attention.</h2>
      </div>
      <p class="reveal" style="--d:.1s">Nous réparons les véhicules de toutes marques. Votre devis tient compte du modèle, de la peinture et de l’état de la voiture.</p>
    </div>
    <div class="ticker"><LogoMarquee label="Marques prises en charge" items={makes} accent="orange" reverse duration={46} /></div>
  </section>

  <section class="section" aria-labelledby="faq-t">
    <div class="wrap two">
      <h2 id="faq-t" class="sec-t reveal">Questions pratiques</h2>
      <div class="reveal"><FaqList items={carroHome.faq} accent="orange" /></div>
    </div>
  </section>

  <CtaBand title="Parlons de votre véhicule." href="/carrosserie/contact/" />
  <AccessBlock quote="carrosserie" />
</SpaceLayout>

<style>
  .wrap { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--pad); }
  .label { margin: 0; }
  .muted { color: var(--mute); }
  .big { margin: 14px 0 40px; font: 800 clamp(2.8rem, 7vw, 6rem) / 0.88 var(--f-display); text-transform: uppercase; letter-spacing: -0.005em; }

  /* Hero */
  .hero { position: relative; display: flex; align-items: flex-end; min-height: min(78svh, 760px); color: #fff; overflow: hidden; isolation: isolate; background: #000; }
  .hero :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 24% 0%; z-index: -3; transform: scaleX(-1); }
  /* L'image est retournée ici (personnage à droite, texte à gauche) ; object-position se lit sur l'image d'origine. */
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -2; background: linear-gradient(to top, rgba(160, 40, 0, 0.94) 0%, rgba(196, 52, 0, 0.55) 38%, rgba(0, 0, 0, 0.12) 75%), linear-gradient(to bottom, rgba(0, 0, 0, 0.4), transparent 30%); }
  .hero-in { width: 100%; max-width: var(--wrap); margin: 0 auto; padding: 120px var(--pad) clamp(96px, 11vw, 150px); }
  .hero .label { opacity: 0.95; }
  /* Vignette « Franchise offerte » : dans le flux, au-dessus du libellé (ne chevauche jamais le titre) */
  .hero-in :global(.hero-promo) { margin-bottom: 20px; --bleed: calc(var(--pad) + max(0px, (100vw - var(--wrap)) / 2)); }
  .hero h1 { margin: 14px 0 18px; font: 800 clamp(3.2rem, 6.6vw, 7.2rem) / 0.84 var(--f-display); /* un peu plus petit qu’en mécanique : laisse le visage libre à droite */ text-transform: uppercase; letter-spacing: -0.005em; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25); }
  .sub { margin: 0 0 30px; font: 500 clamp(1.1rem, 1.8vw, 1.45rem) / 1.35 var(--f-body); max-width: 34ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .pill { display: inline-flex; align-items: center; gap: 14px; background: #fff; color: var(--ink); border-radius: 999px; padding: 8px 8px 8px 26px; font: 700 1rem var(--f-body); text-decoration: none; transition: background 0.3s, color 0.3s; }
  .pill i { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--orange); color: #111; font-style: normal; transition: transform 0.3s, background 0.3s, color 0.3s; }
  .pill:hover { background: var(--orange); color: #111; }
  .pill:hover i { background: #fff; transform: rotate(45deg); }
  .ghost { display: inline-flex; align-items: center; padding: 15px 26px; border-radius: 999px; border: 1.5px solid rgba(255, 255, 255, 0.85); color: #fff; font: 700 1rem var(--f-body); text-decoration: none; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); background: rgba(0, 0, 0, 0.15); transition: background 0.25s, color 0.25s; }
  .ghost:hover { background: #fff; color: var(--ink); }
  .pill.dark { background: var(--ink); color: #fff; }
  .pill.dark i { background: var(--orange); color: #111; }
  .pill.dark:hover { background: var(--orange); color: #111; }
  .pill.dark:hover i { background: var(--ink); color: #fff; }

  /* Sections */
  .section { padding: clamp(60px, 9vw, 120px) 0; scroll-margin-top: 80px; }
  .section.alt { background: #fff; border-block: 1px solid var(--line); }
  .note { margin: 26px 0 0; color: var(--mute); font-size: 0.95rem; }

  .ins { padding-top: clamp(60px, 9vw, 120px); background: #fff; border-block: 1px solid var(--line); scroll-margin-top: 80px; }
  .ins-in, .multi-in { display: grid; gap: 20px 60px; align-items: end; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .ins-in, .multi-in { grid-template-columns: 1.3fr 1fr; } }
  .ins-in p, .multi-in p { margin: 0 0 24px; font-size: 1.15rem; color: var(--ink-soft); max-width: 44ch; }
  .multi-in p { margin-bottom: 40px; }
  .ins-in .big, .multi-in .big { margin-bottom: 30px; }
  .all { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 40px; font: 700 1.05rem var(--f-body); text-decoration: none; border-bottom: 2px solid var(--orange); padding-bottom: 3px; }
  .all:hover .ic { transform: translate(2px, -2px); }
  .ticker { border-top: 1px solid var(--line); background: #fff; }
  .ticker :global(.trow) { border-top: 0; }
  .multi { padding-top: clamp(60px, 9vw, 120px); }
  .multi .ticker { border-block: 1px solid var(--line); }

  .section.alt[id] { scroll-margin-top: 80px; }
  .adv-head { display: grid; gap: 0 60px; align-items: end; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .adv-head { grid-template-columns: 1.3fr 1fr; } }
  .adv-lead { margin: 0 0 40px; font-size: 1.15rem; color: var(--ink-soft); max-width: 44ch; }

  .two { display: grid; gap: 22px 60px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .two { grid-template-columns: 340px 1fr; } }
  .sec-t { margin: 0; font: 800 clamp(2rem, 3.6vw, 3rem) / 0.95 var(--f-display); text-transform: uppercase; }
</style>
