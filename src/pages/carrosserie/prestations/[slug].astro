---
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SpaceLayout from '../../../layouts/SpaceLayout.astro';
import PhotoCard from '../../../components/PhotoCard.astro';
import StepsList from '../../../components/StepsList.astro';
import FaqList from '../../../components/FaqList.astro';
import CtaBand from '../../../components/CtaBand.astro';
import AccessBlock from '../../../components/AccessBlock.astro';
import site from '../../../data/site.json';
import { carroServices, carroBySlug, carroQuoteHref, type CarroService } from '../../../lib/carrosserie';
import { carroItems } from '../../../lib/cards';

export const getStaticPaths = (() => carroServices.map((s) => ({ params: { slug: s.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const service = carroBySlug(slug!) as CarroService;
const related = service.related.map((r) => carroItems.find((i) => i.key === r)).filter((i) => !!i) as typeof carroItems;

const photos = import.meta.glob<{ default: ImageMetadata }>('../../../assets/illustration/*.jpg', { eager: true });
const photo = photos[`../../../assets/illustration/${service.image}`]?.default;
const quote = carroQuoteHref(service.intervention);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.name} — ${site.name}`,
  serviceType: service.name,
  description: service.seoDescription,
  provider: {
    '@type': ['AutoBodyShop'],
    name: site.name,
    telephone: site.phone.tel,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.postalCode,
      addressLocality: site.address.city,
      addressCountry: site.address.country,
    },
  },
};
---
<SpaceLayout space="carrosserie" title={service.seoTitle} description={service.seoDescription} jsonLd={jsonLd}>
  <section class="top">
    <div class="wrap top-in">
      <div class="txt">
        <nav class="crumbs" aria-label="Fil d’Ariane">
          <a href="/carrosserie/">Carrosserie</a> <span aria-hidden="true">›</span>
          <a href="/carrosserie/prestations/">Prestations</a> <span aria-hidden="true">›</span>
          <span>{service.name}</span>
        </nav>
        <p class="label">Carrosserie</p>
        <h1>{service.name}</h1>
        <p class="lead">{service.lead}</p>

        <div class="quote-box">
          <p class="q-t">Sur devis</p>
          <p class="q-note">Chaque dommage est différent : le devis est établi à partir de votre demande, sans engagement de votre part.</p>
          <a class="pill" href={quote}>Demander un devis <i><svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></i></a>
        </div>
      </div>
      {photo && (
        <div class="shot">
          <Image src={photo} alt={service.imageAlt} widths={[480, 800, 1100]} sizes="(max-width: 960px) 100vw, 46vw" format="webp" quality={72} loading="eager" fetchpriority="high" />
        </div>
      )}
    </div>
  </section>

  <section class="block" aria-labelledby="need">
    <div class="wrap two">
      <h2 id="need" class="sec-t reveal">Le besoin</h2>
      <div class="prose reveal">
        {service.need.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="block alt" aria-labelledby="cases">
    <div class="wrap two">
      <h2 id="cases" class="sec-t reveal">Dans quels cas nous consulter</h2>
      <ul class="list reveal">
        {service.cases.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="block" aria-labelledby="steps">
    <div class="wrap">
      <div class="reveal">
        <StepsList steps={service.steps} accent="orange">
          <h2 slot="head" id="steps" class="sec-t">Comment se déroule l’intervention</h2>
        </StepsList>
      </div>
    </div>
  </section>

  {service.insurance && (
    <section class="block alt" aria-labelledby="ins">
      <div class="wrap two">
        <h2 id="ins" class="sec-t reveal">Et votre assurance ?</h2>
        <div class="reveal">
          <div class="prose">
            {service.insurance.map((p) => <p>{p}</p>)}
          </div>
          <a class="more" href="/carrosserie/assurances/">Voir comment nous vous accompagnons <svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></a>
        </div>
      </div>
    </section>
  )}

  <section class:list={['block', { alt: !service.insurance }]} aria-labelledby="price">
    <div class="wrap two">
      <h2 id="price" class="sec-t reveal">Ce qui fait varier le prix</h2>
      <div class="reveal">
        <ul class="list">
          {service.priceFactors.map((p) => <li>{p}</li>)}
        </ul>
        <p class="small">Il n’y a pas de prix d’appel en carrosserie : le devis est personnalisé, établi à partir de votre demande et, si besoin, de l’examen du véhicule.</p>
      </div>
    </div>
  </section>

  <section class:list={['block', { alt: !!service.insurance }]} aria-labelledby="prep">
    <div class="wrap two">
      <h2 id="prep" class="sec-t reveal">Pour préparer votre demande</h2>
      <div class="reveal">
        <p class="small first">Plus votre description est précise, plus notre réponse sera adaptée. Ayez sous la main :</p>
        <ul class="list">
          {service.vehicleInfo.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class:list={['block', { alt: !service.insurance }]} aria-labelledby="faq">
    <div class="wrap two">
      <h2 id="faq" class="sec-t reveal">Questions fréquentes</h2>
      <div class="reveal"><FaqList items={service.faq} accent="orange" /></div>
    </div>
  </section>

  {related.length > 0 && (
    <section class:list={['block', { alt: !!service.insurance }]} aria-labelledby="rel">
      <div class="wrap">
        <h2 id="rel" class="sec-t reveal">Autres situations</h2>
        <ul class="grid">
          {related.map((s, i) => <li class="reveal" style={`--d:${i * 0.07}s`}><PhotoCard item={s} index={carroItems.indexOf(s)} accent="orange" /></li>)}
        </ul>
      </div>
    </section>
  )}

  <CtaBand title="Parlons de votre véhicule." href={quote} />
  <AccessBlock quote="carrosserie" />
</SpaceLayout>

<style>
  .wrap { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--pad); }
  .label { margin: 0 0 10px; color: var(--orange-deep); }

  .top { background: #fff; border-bottom: 1px solid var(--line); padding: clamp(30px, 4vw, 56px) 0 clamp(40px, 6vw, 80px); }
  .top-in { display: grid; gap: 36px 56px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 961px) { .top-in { grid-template-columns: 1.1fr 1fr; } }
  .crumbs { font-size: 0.9rem; color: var(--mute); margin-bottom: 26px; }
  .crumbs a { display: inline-block; padding: 3px 0; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
  .crumbs span[aria-hidden] { margin: 0 8px; }
  h1 { margin: 0 0 18px; font: 800 clamp(3.2rem, 9vw, 7.6rem) / 0.84 var(--f-display); text-transform: uppercase; letter-spacing: -0.005em; overflow-wrap: anywhere; }
  .lead { margin: 0 0 28px; font-size: 1.2rem; line-height: 1.45; color: var(--ink-soft); max-width: 46ch; }
  .quote-box { display: grid; gap: 10px; justify-items: start; padding: 22px 24px; background: var(--paper); border-left: 6px solid var(--orange); border-radius: 0 16px 16px 0; max-width: 520px; }
  .q-t { margin: 0; font: 800 2.4rem/1 var(--f-display); text-transform: uppercase; }
  .q-note { margin: 0; font-size: 0.92rem; color: var(--mute); }
  .pill { display: inline-flex; align-items: center; gap: 14px; background: var(--orange); color: #111; border-radius: 999px; padding: 8px 8px 8px 26px; font: 700 1rem var(--f-body); text-decoration: none; transition: background 0.3s, color 0.3s; margin-top: 4px; }
  .pill i { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #fff; color: var(--ink); font-style: normal; transition: transform 0.3s; }
  .pill:hover { background: var(--ink); color: #fff; }
  .pill:hover i { transform: rotate(45deg); }
  .shot { position: relative; aspect-ratio: 4 / 3.2; border-radius: 26px; overflow: hidden; }
  .shot :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shot::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(196, 52, 0, 0.4), transparent 55%); }

  .block { padding: clamp(46px, 7vw, 92px) 0; }
  .block.alt { background: #fff; border-block: 1px solid var(--line); }
  .two { display: grid; gap: 22px 60px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .two { grid-template-columns: 340px 1fr; } }
  .sec-t { margin: 0 0 28px; font: 800 clamp(2rem, 3.6vw, 3rem) / 0.95 var(--f-display); text-transform: uppercase; }
  .two .sec-t { margin: 0; }
  .prose p { margin: 0 0 1.1em; font-size: 1.14rem; line-height: 1.6; color: var(--ink-soft); max-width: 62ch; }
  .prose p:last-child { margin-bottom: 0; }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; font: 700 1rem var(--f-body); text-decoration: none; border-bottom: 2px solid var(--orange); padding: 4px 0 2px; }
  .more:hover .ic { transform: translate(2px, -2px); }

  .list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .list li { position: relative; padding-left: 30px; font-size: 1.1rem; line-height: 1.5; color: var(--ink-soft); max-width: 62ch; }
  .list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 14px; height: 4px; background: var(--orange); transform: skewX(-30deg); }
  .small { margin: 18px 0 0; font-size: 0.95rem; color: var(--mute); max-width: 62ch; }
  .small.first { margin: 0 0 14px; }

.grid { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); }
  .block .sec-t + .grid { margin-top: 0; }
  .block > .wrap > .sec-t { margin-bottom: 28px; }
</style>
