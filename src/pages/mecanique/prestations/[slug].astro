---
import type { GetStaticPaths } from 'astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SpaceLayout from '../../../layouts/SpaceLayout.astro';
import PhotoCard from '../../../components/PhotoCard.astro';
import AccessBlock from '../../../components/AccessBlock.astro';
import site from '../../../data/site.json';
import { details, serviceBySlug, families, formatPrice, quoteHref, type Service } from '../../../lib/mecanique';
import { mecaItems } from '../../../lib/cards';

export const getStaticPaths = (() => Object.keys(details).map((slug) => ({ params: { slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const service = serviceBySlug(slug!) as Service;
const detail = details[slug!];
const family = families.find((f) => f.id === service.family);
const related = detail.related.map((r) => mecaItems.find((i) => i.key === r)).filter((i) => !!i) as typeof mecaItems;

const photos = import.meta.glob<{ default: ImageMetadata }>('../../../assets/illustration/*.jpg', { eager: true });
const photo = photos[`../../../assets/illustration/${detail.image}`]?.default;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.name} — ${site.name}`,
  serviceType: service.name,
  description: detail.seoDescription,
  provider: {
    '@type': ['AutoRepair'],
    name: site.name,
    telephone: site.phone.tel,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.postalCode,
      addressLocality: site.address.city,
      addressCountry: site.address.country,
    },
  },
};
---
<SpaceLayout space="mecanique" title={detail.seoTitle} description={detail.seoDescription} jsonLd={jsonLd}>
  <section class="top">
    <div class="wrap top-in">
      <div class="txt">
        <nav class="crumbs" aria-label="Fil d’Ariane">
          <a href="/mecanique/">Mécanique</a> <span aria-hidden="true">›</span>
          <a href="/mecanique/prestations/">Prestations</a> <span aria-hidden="true">›</span>
          <span>{service.name}</span>
        </nav>
        <p class="label">{family?.name}</p>
        <h1>{service.name}</h1>
        <p class="lead">{detail.lead}</p>

        <div class="price-box">
          {service.priceFrom === null
            ? <p class="price"><b class="devis">Sur devis</b></p>
            : <p class="price"><small>À partir de</small><b>{formatPrice(service.priceFrom)}</b></p>}
          <p class="price-note">Prix d’appel, selon véhicule et intervention. Votre devis est personnalisé.</p>
          <a class="pill" href={quoteHref(service.slug)}>Demander un devis {service.name.toLowerCase()} <i><svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></i></a>
        </div>
      </div>
      {photo && (
        <div class="shot">
          <Image src={photo} alt={detail.imageAlt ?? ''} widths={[480, 800, 1100]} sizes="(max-width: 960px) 100vw, 46vw" format="webp" quality={72} loading="eager" fetchpriority="high" />
        </div>
      )}
    </div>
  </section>

  <section class="block" aria-labelledby="need">
    <div class="wrap two">
      <h2 id="need" class="sec-t reveal">Le besoin</h2>
      <div class="prose reveal">
        {detail.need.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="block alt" aria-labelledby="signs">
    <div class="wrap two">
      <h2 id="signs" class="sec-t reveal">Les signes qui doivent vous alerter</h2>
      <ul class="signs reveal">
        {detail.signs.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="block" aria-labelledby="steps">
    <div class="wrap">
      <h2 id="steps" class="sec-t reveal">Comment se déroule l’intervention</h2>
      <ol class="steps">
        {detail.steps.map((st, i) => (
          <li class="reveal" style={`--d:${i * 0.07}s`}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.title}</h3>
            <p>{st.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block alt" aria-labelledby="price">
    <div class="wrap two">
      <h2 id="price" class="sec-t reveal">Ce qui fait varier le prix</h2>
      <div class="reveal">
        <ul class="plain">
          {detail.priceFactors.map((p) => <li>{p}</li>)}
        </ul>
        <p class="small">Le prix d’appel n’est pas un devis définitif : il sert de repère avant l’examen de votre véhicule.</p>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="prep">
    <div class="wrap two">
      <h2 id="prep" class="sec-t reveal">Pour préparer votre demande</h2>
      <div class="reveal">
        <p class="small first">Plus votre description est précise, plus notre réponse sera adaptée. Ayez sous la main :</p>
        <ul class="plain">
          {detail.vehicleInfo.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="block alt" aria-labelledby="faq">
    <div class="wrap two">
      <h2 id="faq" class="sec-t reveal">Questions fréquentes</h2>
      <div class="faq reveal">
        {detail.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="block" aria-labelledby="rel">
      <div class="wrap">
        <h2 id="rel" class="sec-t reveal">Prestations liées</h2>
        <ul class="grid">
          {related.map((s, i) => <li class="reveal" style={`--d:${i * 0.07}s`}><PhotoCard item={s} index={mecaItems.indexOf(s)} accent="blue" /></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap band-in">
      <h2>Parlons de votre véhicule.</h2>
      <a class="pill" href={quoteHref(service.slug)}>Demander un devis <i><svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></i></a>
    </div>
  </section>

  <AccessBlock quote="mecanique" />
</SpaceLayout>

<style>
  .wrap { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--pad); }
  .label { margin: 0 0 10px; color: var(--blue); }

  .top { background: #fff; border-bottom: 1px solid var(--line); padding: clamp(30px, 4vw, 56px) 0 clamp(40px, 6vw, 80px); }
  .top-in { display: grid; gap: 36px 56px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 961px) { .top-in { grid-template-columns: 1.1fr 1fr; } }
  .crumbs { font-size: 0.9rem; color: var(--mute); margin-bottom: 26px; }
  .crumbs a { text-decoration: none; border-bottom: 1px solid var(--line); }
  .crumbs span[aria-hidden] { margin: 0 8px; }
  h1 { margin: 0 0 18px; font: 800 clamp(3.6rem, 10vw, 8.6rem) / 0.82 var(--f-display); text-transform: uppercase; letter-spacing: -0.005em; }
  .lead { margin: 0 0 28px; font-size: 1.2rem; line-height: 1.45; color: var(--ink-soft); max-width: 46ch; }
  .price-box { display: grid; gap: 12px; justify-items: start; padding: 22px 24px; background: var(--paper); border-left: 6px solid var(--blue); border-radius: 0 16px 16px 0; max-width: 520px; }
  .price { margin: 0; display: grid; line-height: 1; }
  .price small { font-size: 0.9rem; color: var(--mute); margin-bottom: 4px; }
  .price b { font: 800 3.4rem/1 var(--f-display); }
  .price .devis { font-size: 2.4rem; }
  .price-note { margin: 0; font-size: 0.9rem; color: var(--mute); }
  .pill { display: inline-flex; align-items: center; gap: 14px; background: var(--blue); color: #fff; border-radius: 999px; padding: 8px 8px 8px 26px; font: 700 1rem var(--f-body); text-decoration: none; transition: background 0.3s; margin-top: 4px; }
  .pill i { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #fff; color: var(--ink); font-style: normal; transition: transform 0.3s; }
  .pill:hover { background: var(--ink); }
  .pill:hover i { transform: rotate(45deg); }
  .shot { position: relative; aspect-ratio: 4 / 3.2; border-radius: 26px; overflow: hidden; }
  .shot :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shot::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(18, 40, 190, 0.35), transparent 55%); }

  .block { padding: clamp(46px, 7vw, 92px) 0; }
  .block.alt { background: #fff; border-block: 1px solid var(--line); }
  .two { display: grid; gap: 22px 60px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .two { grid-template-columns: 340px 1fr; } }
  .sec-t { margin: 0 0 28px; font: 800 clamp(2rem, 3.6vw, 3rem) / 0.95 var(--f-display); text-transform: uppercase; }
  .two .sec-t { margin: 0; }
  .prose p { margin: 0 0 1.1em; font-size: 1.14rem; line-height: 1.6; color: var(--ink-soft); max-width: 62ch; }
  .prose p:last-child { margin-bottom: 0; }

  .signs, .plain { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .signs li, .plain li { position: relative; padding-left: 30px; font-size: 1.1rem; line-height: 1.5; color: var(--ink-soft); max-width: 62ch; }
  .signs li::before, .plain li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 14px; height: 4px; background: var(--blue); transform: skewX(-30deg); }
  .small { margin: 18px 0 0; font-size: 0.95rem; color: var(--mute); max-width: 62ch; }
  .small.first { margin: 0 0 14px; }

  .steps { display: grid; gap: 26px; margin: 0; padding: 0; list-style: none; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .steps li { padding-top: 22px; border-top: 3px solid var(--blue); }
  .n { display: block; font: 800 3rem/1 var(--f-display); color: var(--blue); margin-bottom: 8px; }
  .steps h3 { margin: 0 0 8px; font: 800 1.4rem/1.05 var(--f-display); text-transform: uppercase; }
  .steps p { margin: 0; color: var(--mute); }

  .faq { display: grid; border-top: 1.5px solid var(--ink); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; padding: 20px 0; font: 700 1.12rem/1.3 var(--f-body); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; flex: none; font: 400 1.7rem/1 var(--f-body); color: var(--blue); }
  .faq details[open] summary::after { content: '–'; }
  .faq p { margin: 0 0 22px; max-width: 62ch; color: var(--ink-soft); line-height: 1.6; }

.grid { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); }

  .band { background: var(--blue); background-image: linear-gradient(100deg, #1238f5, #4910bc); color: #fff; padding: clamp(40px, 6vw, 70px) 0; }
  .band-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 22px; }
  .band h2 { margin: 0; font: 800 clamp(2.4rem, 6vw, 4.6rem) / 0.9 var(--f-display); text-transform: uppercase; }
  .band .pill { background: #fff; color: var(--ink); }
  .band .pill i { background: var(--blue); color: #fff; }
  .band .pill:hover { background: var(--ink); color: #fff; }
</style>
