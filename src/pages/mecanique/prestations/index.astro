---
import SpaceLayout from '../../../layouts/SpaceLayout.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import AccessBlock from '../../../components/AccessBlock.astro';
import { families, byFamily } from '../../../lib/mecanique';
---
<SpaceLayout
  space="mecanique"
  title="Prestations mécanique et prix d’appel — Garage multimarque à Bischheim | WCC"
  description="Catalogue des prestations mécanique : entretien, moteur et transmission, freinage, diagnostic, climatisation. Prix d’appel affichés, devis adapté à votre véhicule."
>
  <section class="head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Fil d’Ariane"><a href="/mecanique/">Mécanique</a> <span aria-hidden="true">›</span> <span>Prestations</span></nav>
      <h1>Toutes nos<br />prestations mécanique.</h1>
      <p>Entretien et réparation multimarque. Les prix « à partir de » sont des prix d’appel : le devis est adapté à votre véhicule et à l’intervention.</p>
      <ul class="chips" aria-label="Aller à une famille de prestations">
        {families.map((f) => <li><a href={`#${f.id}`}>{f.name}</a></li>)}
      </ul>
    </div>
  </section>

  {families.map((f, i) => (
    <section class:list={['fam', { alt: i % 2 === 1 }]} id={f.id} aria-labelledby={`h-${f.id}`}>
      <div class="wrap">
        <div class="fam-h reveal">
          <h2 id={`h-${f.id}`}>{f.name}</h2>
          <p>{f.blurb}</p>
        </div>
        <ul class="grid">
          {byFamily(f.id).map((s, j) => (
            <li class="reveal" style={`--d:${(j % 3) * 0.07}s`}><ServiceCard service={s} /></li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="foot-note">
    <div class="wrap">
      <p>Tarif selon véhicule et intervention. Devis personnalisé. Vous ne trouvez pas votre besoin ? <a href="/mecanique/contact/">Décrivez-nous votre problème</a>.</p>
    </div>
  </section>

  <AccessBlock quote="mecanique" />
</SpaceLayout>

<style>
  .wrap { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--pad); }
  .head { padding: clamp(36px, 5vw, 70px) 0 clamp(36px, 5vw, 60px); background: #fff; border-bottom: 1px solid var(--line); }
  .crumbs { font-size: 0.9rem; color: var(--mute); margin-bottom: 18px; }
  .crumbs a { text-decoration: none; border-bottom: 1px solid var(--line); }
  .crumbs span[aria-hidden] { margin: 0 8px; }
  h1 { margin: 0 0 18px; font: 800 clamp(3rem, 8.5vw, 7.4rem) / 0.86 var(--f-display); text-transform: uppercase; letter-spacing: -0.005em; }
  .head p { margin: 0 0 26px; max-width: 54ch; font-size: 1.12rem; color: var(--ink-soft); }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .chips a { display: inline-block; padding: 10px 18px; border: 1.5px solid var(--ink); border-radius: 999px; text-decoration: none; font: 600 0.95rem var(--f-body); transition: background 0.25s, color 0.25s; }
  .chips a:hover { background: var(--ink); color: #fff; }

  .fam { padding: clamp(50px, 7vw, 90px) 0; scroll-margin-top: 90px; }
  .fam.alt { background: #fff; border-block: 1px solid var(--line); }
  .fam-h { margin-bottom: 30px; }
  .fam-h h2 { margin: 0 0 8px; font: 800 clamp(2.2rem, 5vw, 4rem) / 0.92 var(--f-display); text-transform: uppercase; }
  .fam-h p { margin: 0; color: var(--mute); max-width: 50ch; }
  .grid { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); }
  .foot-note { padding: 40px 0 70px; }
  .foot-note p { margin: 0; color: var(--mute); }
  .foot-note a { color: var(--ink); font-weight: 600; }
</style>
