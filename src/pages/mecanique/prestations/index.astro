---
import { Image } from 'astro:assets';
import SpaceLayout from '../../../layouts/SpaceLayout.astro';
import AccessBlock from '../../../components/AccessBlock.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { families, formatPrice, percentLabel, promoNote } from '../../../lib/mecanique';
import { mecaItems } from '../../../lib/cards';

const sections = families.map((f, i) => {
  const items = mecaItems.filter((s) => s.family === f.id);
  return { ...f, n: String(i + 1).padStart(2, '0'), items, image: items[0]?.image };
});
---
<SpaceLayout
  space="mecanique"
  title="Prestations mécanique et prix d’appel — Garage multimarque à Bischheim | WCC"
  description="Catalogue des prestations mécanique : entretien, moteur et transmission, freinage, diagnostic, climatisation. Prix d’appel affichés, devis adapté à votre véhicule."
>
  <section class="head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Fil d’Ariane"><a href="/mecanique/">Mécanique</a> <span aria-hidden="true">›</span> <span>Prestations</span></nav>
      <h1>Toutes nos<br />prestations mécanique.</h1>
      <p>Entretien et réparation multimarque. Les prix « à partir de » sont des prix d’appel : le devis est adapté à votre véhicule et à l’intervention.</p>
    </div>
  </section>

  <div class="tools" data-tools>
    <div class="wrap tools-in">
      <div class="search">
        <label class="sr-only" for="q">Rechercher une prestation</label>
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="q" type="search" placeholder="Rechercher : freins, vidange…" autocomplete="off" data-q />
      </div>
      <nav class="fams" aria-label="Aller à une famille de prestations">
        {sections.map((f) => <a href={`#${f.id}`}><span>{f.n}</span>{f.name.split(',')[0].split(' et ')[0]}</a>)}
      </nav>
    </div>
  </div>

  <div class="wrap catalogue">
    <p class="status sr-only" role="status" aria-live="polite" data-status></p>
    {sections.map((f) => (
      <section class="fam" id={f.id} aria-labelledby={`h-${f.id}`} data-fam>
        <header class="fam-h">
          <span class="num" aria-hidden="true">{f.n}</span>
          <h2 id={`h-${f.id}`}>{f.name}</h2>
          <p>{f.blurb}</p>
          {f.image && <div class="shot"><Image src={f.image} alt="" widths={[320, 520]} sizes="(max-width: 900px) 100vw, 300px" format="webp" quality={68} loading="lazy" /></div>}
        </header>
        <ul class="rows">
          {f.items.map((s) => (
            <li class="row" data-row data-search={`${s.name} ${s.short}`}>
              <div class="r-txt">
                <h3><a href={s.href}>{s.name}</a></h3>
                <p>{s.short}</p>
              </div>
              <div class="r-price">
                {!s.price ? <span class="devis">Sur devis</span> : (
                  <>
                    <small>à partir de {s.price.percent > 0 && <s>{formatPrice(s.price.regular)}</s>}</small>
                    <span class="now"><b>{formatPrice(s.price.current)}</b>{s.price.percent > 0 && <em>{percentLabel(s.price.percent)}</em>}</span>
                  </>
                )}
              </div>
              <a class="r-go" href={s.quoteHref} aria-label={`Demander un devis : ${s.name}`}>
                <span>Devis</span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="empty" data-empty hidden>Aucune prestation ne correspond à votre recherche. <a href="/mecanique/contact/">Décrivez-nous votre problème</a>, nous vous répondrons.</p>
    <p class="note">Tarif selon véhicule et intervention. Devis personnalisé. {promoNote} Vous ne trouvez pas votre besoin ? <a href="/mecanique/contact/">Décrivez-nous votre problème</a>.</p>
  </div>

  <CtaBand title="Un devis pour votre véhicule ?" href="/mecanique/contact/" accent="blue" />
  <AccessBlock quote="mecanique" />
</SpaceLayout>

<script>
  // Recherche instantanée : masque les lignes (et les familles vides) qui ne correspondent pas
  const q = document.querySelector<HTMLInputElement>('[data-q]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const fams = [...document.querySelectorAll<HTMLElement>('[data-fam]')];
  const status = document.querySelector<HTMLElement>('[data-status]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  q?.addEventListener('input', () => {
    const terms = norm(q.value).split(/\s+/).filter(Boolean);
    let shown = 0;
    rows.forEach((r) => {
      const hay = norm(r.dataset.search ?? '');
      const ok = terms.every((t) => hay.includes(t));
      r.hidden = !ok;
      if (ok) shown++;
    });
    fams.forEach((f) => { f.hidden = !f.querySelector('[data-row]:not([hidden])'); });
    if (empty) empty.hidden = shown > 0;
    if (status) status.textContent = terms.length ? `${shown} prestation${shown > 1 ? 's' : ''} trouvée${shown > 1 ? 's' : ''}` : '';
  });
</script>

<style>
  .wrap { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--pad); }
  .head { padding: clamp(36px, 5vw, 70px) 0 clamp(30px, 4vw, 48px); background: #fff; }
  .crumbs { font-size: 0.9rem; color: var(--mute); margin-bottom: 18px; }
  .crumbs a { text-decoration: none; border-bottom: 1px solid var(--line); }
  .crumbs span[aria-hidden] { margin: 0 8px; }
  h1 { margin: 0 0 18px; font: 800 clamp(3rem, 8.5vw, 7.4rem) / 0.86 var(--f-display); text-transform: uppercase; letter-spacing: -0.005em; }
  .head p { margin: 0; max-width: 54ch; font-size: 1.12rem; color: var(--ink-soft); }

  /* Barre d'outils : recherche + familles */
  .tools { position: sticky; top: 76px; z-index: 40; background: #fff; border-block: 1px solid var(--line); box-shadow: 0 14px 20px -18px rgba(17, 19, 23, 0.4); }
  .tools-in { display: grid; gap: 12px 24px; align-items: center; padding-block: 12px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .tools-in { grid-template-columns: minmax(300px, 420px) 1fr; } }
  .search { position: relative; }
  .search .ic { position: absolute; left: 16px; top: 50%; width: 20px; height: 20px; transform: translateY(-50%); color: var(--mute); pointer-events: none; }
  .search input {
    width: 100%; height: 50px; padding: 0 16px 0 46px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--paper);
    font: 500 1rem var(--f-body); color: var(--ink);
  }
  .search input:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; background: #fff; }
  .fams { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .fams::-webkit-scrollbar { display: none; }
  .fams a {
    flex: none; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; text-decoration: none;
    font: 700 1rem/1 var(--f-display); letter-spacing: 0.08em; text-transform: uppercase; transition: background 0.2s, color 0.2s;
  }
  .fams a span { font-size: 0.85em; color: var(--blue); }
  .fams a:hover { background: var(--blue); color: #fff; }
  .fams a:hover span { color: #fff; }

  /* Familles */
  .catalogue { padding-block: clamp(30px, 5vw, 70px) clamp(40px, 6vw, 80px); }
  .fam { display: grid; gap: 22px 56px; padding-block: clamp(34px, 5vw, 64px); border-top: 2px solid var(--ink); scroll-margin-top: 150px; grid-template-columns: 1fr; }
  .fam[hidden] { display: none; }
  .fam:first-of-type { border-top: 0; }
  @media (min-width: 1000px) { .fam { grid-template-columns: 300px 1fr; } .fam-h { position: sticky; top: 160px; align-self: start; } }
  .num { display: block; font: 800 clamp(3.4rem, 7vw, 5.4rem) / 0.8 var(--f-display); color: transparent; -webkit-text-stroke: 1.5px var(--blue); }
  .fam-h h2 { margin: 12px 0 8px; font: 800 clamp(1.9rem, 3vw, 2.4rem) / 0.95 var(--f-display); text-transform: uppercase; }
  .fam-h p { margin: 0; color: var(--mute); max-width: 30ch; }
  .shot { display: none; margin-top: 22px; aspect-ratio: 4 / 3; overflow: hidden; clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 0 100%); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 1000px) { .shot { display: block; } }

  /* Lignes de prestation */
  .rows { margin: 0; padding: 0; list-style: none; }
  .row { position: relative; display: grid; gap: 6px 24px; align-items: center; padding: 22px 20px 22px 24px; border-bottom: 1px solid var(--line); transition: background 0.25s; grid-template-columns: 1fr auto; }
  .row[hidden] { display: none; }
  .rows .row:first-child { border-top: 1px solid var(--line); }
  .row::before { content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 5px; background: var(--blue); transform: scaleY(0); transform-origin: center; transition: transform 0.3s var(--ease); }
  .row:hover, .row:focus-within { background: #fff; }
  .row:hover::before, .row:focus-within::before { transform: scaleY(1); }
  .r-txt h3 { margin: 0 0 4px; font: 800 clamp(1.5rem, 2.4vw, 2rem) / 1 var(--f-display); text-transform: uppercase; letter-spacing: 0.005em; }
  .r-txt h3 a { text-decoration: none; }
  .r-txt h3 a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .r-txt h3 a:focus-visible { outline: none; }
  .row:has(h3 a:focus-visible) { outline: 3px solid var(--blue); outline-offset: -3px; }
  .r-txt p { margin: 0; max-width: 56ch; color: var(--mute); font-size: 0.98rem; line-height: 1.45; }
  .r-price { display: grid; justify-items: end; gap: 2px; text-align: right; line-height: 1; grid-column: 1; }
  .r-price small { font-size: 0.9rem; color: var(--mute); }
  .r-price s { margin-left: 0.35em; font-size: 1.05rem; font-weight: 600; color: var(--ink-soft); text-decoration-thickness: 2px; }
  .now { display: flex; align-items: center; gap: 10px; }
  .r-price b { font: 800 2rem/1 var(--f-display); letter-spacing: 0.01em; }
  .r-price em { padding: 4px 8px; background: var(--blue); color: #fff; font: 800 1rem/1 var(--f-display); font-style: normal; letter-spacing: 0.04em; transform: skewX(-10deg); }
  .devis { font: 800 1.5rem/1 var(--f-display); text-transform: uppercase; color: var(--ink-soft); }
  .r-go {
    position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border: 1.5px solid var(--ink); border-radius: 999px;
    text-decoration: none; font: 700 0.92rem var(--f-body); transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .r-go:hover { background: var(--blue); border-color: var(--blue); color: #fff; }
  .r-go:hover .ic { transform: translate(2px, -2px); }

  /* Ordinateur : texte | prix | bouton sur une même ligne */
  @media (min-width: 720px) {
    .row { grid-template-columns: minmax(0, 1fr) 190px auto; }
    .r-price { grid-column: auto; }
  }
  @media (max-width: 719px) {
    .row { padding-inline: 16px; }
    .r-price { justify-items: start; text-align: left; margin-top: 6px; }
    .r-go { justify-self: start; grid-column: 1; margin-top: 8px; }
  }

  .empty { padding: 40px 0; font-size: 1.1rem; color: var(--ink-soft); }
  .note { margin: 34px 0 0; color: var(--mute); font-size: 0.95rem; max-width: 70ch; }
  .note a, .empty a { color: var(--ink); font-weight: 600; }
</style>
