---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import logoMark from '../assets/brand/logo-wcc-mark.webp';
import { heroCarrosserie as carroPhoto, heroMecanique as mecaPhoto } from '../lib/hero';
import FranchiseBadge from './FranchiseBadge.astro';
---
<section class="hero" aria-label="Choisir un espace">
  <div class="top">
    <a href="/" aria-label="World Car Carrosserie — accueil">
      <Image src={logoMark} alt="WCC" width={170} height={50} densities={[1, 2]} loading="eager" />
    </a>
    <div class="top-r">
      <span class="loc"><svg class="ic" aria-hidden="true"><use href="#i-pin" /></svg>{site.address.city}</span>
      <a class="tel" href={`tel:${site.phone.tel}`}>
        <svg class="ic" aria-hidden="true"><use href="#i-phone" /></svg>{site.phone.display}
      </a>
    </div>
  </div>

  <div class="lead"><h1>Deux expertises. Une même exigence.</h1></div>

  <a class="half c" href="/carrosserie/">
    <Image src={carroPhoto} alt="" widths={[480, 800, 1200, 1600]} sizes="(max-width: 860px) 100vw, 50vw" format="webp" quality={72} loading="eager" fetchpriority="high" />
    <div class="hc">
      <FranchiseBadge class="fr" />
      <span class="label">01</span>
      <h2>Carrosserie</h2>
      <p>Réparation, peinture et accompagnement dans vos démarches d’assurance.</p>
      <span class="pill">Découvrir la carrosserie <i><svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></i></span>
    </div>
  </a>
  <a class="half m" href="/mecanique/">
    <Image src={mecaPhoto} alt="" widths={[480, 800, 1200, 1600]} sizes="(max-width: 860px) 100vw, 50vw" format="webp" quality={72} loading="eager" />
    <div class="hc">
      <span class="label">02</span>
      <h2>Mécanique</h2>
      <p>Entretien et réparation multimarque, avec des prix d’appel affichés.</p>
      <span class="pill">Découvrir la mécanique <i><svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></i></span>
    </div>
  </a>
</section>

<style>
  .hero { position: relative; display: flex; min-height: max(640px, 100svh); max-height: 1040px; background: #000; overflow: hidden; color: #fff; }
  .half {
    --acc: var(--orange); container-type: inline-size; position: relative; flex: 1 1 0; min-width: 0;
    display: flex; align-items: flex-end; color: #fff; text-decoration: none; isolation: isolate; overflow: hidden;
    transition: flex-grow 0.9s var(--ease);
  }
  .half.m { --acc: var(--blue); }
  .half + .half { border-left: 1px solid rgba(255, 255, 255, 0.6); }
  .half :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3;
    transition: transform 1.8s var(--ease), filter 0.8s;
  }
  .half.c :global(img) { object-position: 6% 30%; }
  .half.m :global(img) { object-position: 34% 50%; }
  .half::before {
    content: ''; position: absolute; inset: 0; z-index: -2;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 30%), linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0) 62%);
  }
  .half::after { content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0.95; }
  .half.c::after { background: linear-gradient(to top, rgba(196, 52, 0, 0.88) 0%, rgba(196, 52, 0, 0.42) 26%, rgba(196, 52, 0, 0) 56%); }
  .half.m::after { background: linear-gradient(to top, rgba(18, 40, 190, 0.9) 0%, rgba(18, 40, 190, 0.45) 26%, rgba(18, 40, 190, 0) 56%); }
  .half:hover :global(img), .half:focus-visible :global(img) { transform: scale(1.05); }
  .half:focus-visible { outline: 4px solid #fff; outline-offset: -12px; }
  @media (hover: hover) and (min-width: 861px) {
    .hero:hover .half { flex-grow: 0.78; }
    .hero .half:hover { flex-grow: 1.45; }
    .hero:hover .half:not(:hover) :global(img) { filter: brightness(0.72) saturate(0.8); }
  }

  /* Vignette « Franchise offerte » (moitié carrosserie) : dans le flux, au-dessus du numéro */
  .half :global(.fr) { margin-bottom: clamp(14px, 2.4vh, 22px); }

  .hc { width: 100%; padding: 0 var(--pad) clamp(34px, 7vh, 76px); }
  .hc .label { display: flex; align-items: center; gap: 14px; opacity: 0.95; }
  .hc .label::after { content: ''; width: 48px; height: 2px; background: #fff; opacity: 0.7; }
  .half h2 {
    margin: 0.12em 0 0.1em; font: 800 clamp(2.6rem, 15cqi, 9.4rem) / 0.8 var(--f-display);
    text-transform: uppercase; letter-spacing: -0.005em; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25);
  }
  .half p { margin: 0 0 24px; font: 500 clamp(1.05rem, 1.5vw, 1.3rem) / 1.35 var(--f-body); max-width: 30ch; }
  .pill {
    display: inline-flex; align-items: center; gap: 14px; background: #fff; color: var(--ink); border-radius: 999px;
    padding: 8px 8px 8px 26px; font: 700 1rem var(--f-body); transition: background 0.3s, color 0.3s;
  }
  .pill i { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--acc); color: #fff; transition: transform 0.3s, background 0.3s, color 0.3s; font-style: normal; }
  .half.c .pill i { color: #111; }
  .half:hover .pill { background: var(--acc); color: #fff; }
  .half.c:hover .pill { color: #111; }
  .half:hover .pill i { background: #fff; color: var(--ink); transform: rotate(45deg); }

  /* Barre haute et accroche */
  .top {
    position: absolute; z-index: 10; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between;
    gap: 18px; padding: 18px var(--pad); color: #fff; pointer-events: none;
  }
  .top > * { pointer-events: auto; }
  .top :global(img) { height: 50px; width: auto; filter: drop-shadow(0 2px 14px rgba(0, 0, 0, 0.35)); }
  .top-r { display: flex; align-items: center; gap: 18px; }
  .loc { display: none; align-items: center; gap: 8px; font: 600 0.95rem var(--f-body); }
  .tel {
    display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; padding: 11px 22px;
    border: 1.5px solid rgba(255, 255, 255, 0.85); border-radius: 999px; font: 700 0.98rem var(--f-body); text-decoration: none;
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); background: rgba(0, 0, 0, 0.18); transition: background 0.25s, color 0.25s;
  }
  .tel:hover { background: #fff; color: var(--ink); }
  @media (min-width: 700px) { .loc { display: flex; } }
  .lead { position: absolute; z-index: 6; left: 50%; top: clamp(92px, 13vh, 128px); transform: translateX(-50%); width: min(92%, 900px); text-align: center; color: #fff; pointer-events: none; }
  .lead h1 { margin: 0; font: 700 clamp(1.05rem, 2.1vw, 1.7rem) / 1.25 var(--f-display); letter-spacing: 0.24em; text-transform: uppercase; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45); }
  .lead::after { content: ''; display: block; width: 84px; height: 4px; margin: 16px auto 0; background: var(--grad); border-radius: 2px; }

  @media (max-width: 860px) {
    .hero { flex-direction: column; max-height: none; min-height: 0; }
    .half { flex: none; min-height: max(400px, 52svh); }
    .half + .half { border-left: 0; border-top: 1px solid rgba(255, 255, 255, 0.6); }
    .half:first-of-type { min-height: max(450px, 60svh); padding-top: 150px; }
    .lead { top: 92px; }
    .lead h1 { letter-spacing: 0.16em; font-size: 1rem; }
    .tel { padding: 9px 15px; font-size: 0.88rem; }
    .top :global(img) { height: 42px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .half { animation: fade 1.2s var(--ease) both; }
    .half.m { animation-delay: 0.14s; }
    @keyframes fade { from { opacity: 0; } }
    .half h2 { animation: rise 1.1s 0.25s var(--ease) both; }
    @keyframes rise { from { opacity: 0; transform: translateY(40px); } }
    .lead { animation: drop 1s 0.45s var(--ease) both; }
    @keyframes drop { from { opacity: 0; transform: translate(-50%, -14px); } }
  }
</style>
