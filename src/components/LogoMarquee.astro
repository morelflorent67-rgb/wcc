---
/**
 * Bandeau défilant de logos (partenaires assurance, marques de véhicules).
 * Pause au survol et au clavier ; défilement remplacé par une liste fixe si l'utilisateur
 * demande une réduction des animations.
 */
export interface LogoItem {
  name: string;
  /** Logo bitmap (partenaires) */
  src?: string;
  width?: number;
  height?: number;
  /** Icône vectorielle (marques de véhicules), dans la couleur de la marque si `color` est fourni ;
   *  `dark` = couleur claire posée sur une pastille sombre (Renault, Opel) */
  svg?: { viewBox: string; path: string; color?: string; dark?: boolean };
}

interface Props {
  label: string;
  items: LogoItem[];
  accent?: 'orange' | 'blue';
  reverse?: boolean;
  moreHref?: string;
  moreLabel?: string;
  /** Durée d'un tour complet, en secondes */
  duration?: number;
}

const { label, items, accent = 'orange', reverse = false, moreHref, moreLabel, duration = 60 } = Astro.props;
---
<div class:list={['trow', accent]}>
  <div class="lab">
    <span class="lab-t">{label}</span>
    {moreHref && (
      <a class="lab-more" href={moreHref}>
        {moreLabel}
        <svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg>
      </a>
    )}
  </div>
  <div class="track">
    <button type="button" class="mq-pause" aria-label={`Mettre en pause le défilement : ${label}`} aria-pressed="false" hidden>
      <svg class="ic" aria-hidden="true"><use href="#i-pause" data-pause-icon /></svg>
    </button>
    <div class="mq" style={`--dur:${duration}s`} data-reverse={reverse ? '' : undefined}>
      {[false, true].map((dup) => (
        <ul aria-label={dup ? undefined : label} aria-hidden={dup ? 'true' : undefined}>
          {items.map((it) => (
            <li class:list={{ brand: !!it.svg?.color }} style={it.svg?.color ? `--c:${it.svg.color}` : undefined}>
              {it.svg?.color ? (
                <span class:list={['badge', { dark: it.svg.dark }]}>
                  <svg viewBox={it.svg.viewBox} role={dup ? undefined : 'img'} aria-label={dup ? undefined : it.name}>
                    <path d={it.svg.path} />
                  </svg>
                </span>
              ) : it.svg ? (
                <svg viewBox={it.svg.viewBox} role={dup ? undefined : 'img'} aria-label={dup ? undefined : it.name}>
                  <path d={it.svg.path} />
                </svg>
              ) : (
                <img src={it.src} alt={dup ? '' : it.name} width={it.width} height={it.height} loading="lazy" decoding="async" />
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  .trow { --acc: var(--orange); display: flex; align-items: stretch; border-top: 1px solid var(--line); }
  .trow.blue { --acc: var(--blue); }
  .lab {
    flex: none; display: flex; flex-direction: column; justify-content: center; gap: 8px;
    min-width: 300px; padding: 20px var(--pad); border-right: 1px solid var(--line);
  }
  .lab-t {
    display: flex; align-items: center; gap: 12px;
    font: 700 0.86rem/1.1 var(--f-display); letter-spacing: 0.18em; text-transform: uppercase;
  }
  .lab-t::before { content: ''; width: 12px; height: 12px; border-radius: 50%; background: var(--acc); flex: none; }
  .lab-more {
    display: inline-flex; align-items: center; gap: 6px; align-self: flex-start; padding: 4px 0 4px 24px;
    font: 600 0.88rem var(--f-body); color: var(--mute); text-decoration: underline; text-underline-offset: 3px;
  }
  .lab-more:hover { color: var(--ink); }
  .lab-more:hover .ic { transform: translate(2px, -2px); }

  .track {
    flex: 1; min-width: 0; overflow: hidden; display: flex; align-items: center; position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .mq { display: flex; width: max-content; animation: marq var(--dur, 60s) linear infinite; will-change: transform; }
  .mq[data-reverse] { animation-direction: reverse; }
  .track:hover .mq, .trow[data-paused] .mq { animation-play-state: paused; }
  .mq-pause {
    position: absolute; right: 8px; bottom: 6px; z-index: 2; width: 28px; height: 28px; padding: 0; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.92); color: var(--ink); cursor: pointer;
  }
  .mq-pause[hidden] { display: none; }
  .mq-pause .ic { width: 14px; height: 14px; }
  .mq-pause:hover { background: var(--ink); color: #fff; }
  .mq ul { display: flex; align-items: center; margin: 0; padding: 0; list-style: none; }
  .mq li { display: flex; align-items: center; padding: 14px 0; }
  .mq li::after {
    content: ''; width: 7px; height: 7px; margin: 0 40px; flex: none; background: var(--acc); transform: rotate(45deg);
  }
  .mq li img {
    max-height: 54px; max-width: 150px; width: auto; height: auto; object-fit: contain;
    mix-blend-mode: multiply; filter: grayscale(1) contrast(1.05); opacity: 0.82;
    transition: filter 0.3s, opacity 0.3s;
  }
  .mq li img:hover { filter: none; opacity: 1; }
  .mq li svg { height: 44px; width: auto; max-width: 96px; fill: var(--ink-soft); opacity: 0.82; transition: fill 0.3s, opacity 0.3s; }
  .mq li svg:hover { fill: var(--ink); opacity: 1; }

  /* Marques en couleur : pastille blanche (sombre pour les couleurs claires), halo de la couleur de la marque au survol */
  .mq li.brand { padding: 16px 0; }
  .mq li.brand::after { margin: 0 30px; }
  .badge {
    display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%;
    background: #fff; border: 1px solid var(--line); box-shadow: 0 12px 26px -18px rgba(17, 19, 23, 0.55);
    transition: transform 0.4s var(--ease), box-shadow 0.4s, border-color 0.4s;
  }
  .badge.dark { background: #16181d; border-color: #16181d; }
  .mq li.brand .badge svg { width: 42px; height: 42px; max-width: none; fill: var(--c); opacity: 1; }
  .mq li.brand .badge svg:hover { fill: var(--c); }
  .badge:hover {
    transform: translateY(-4px) scale(1.07); border-color: color-mix(in srgb, var(--c) 45%, var(--line));
    box-shadow: 0 18px 34px -16px color-mix(in srgb, var(--c) 70%, transparent);
  }
  @media (max-width: 760px) {
    .badge { width: 64px; height: 64px; }
    .mq li.brand .badge svg { width: 36px; height: 36px; }
    .mq li.brand::after { margin: 0 20px; }
  }
  @keyframes marq { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .mq-pause { display: none; }
    .mq { animation: none; width: auto; flex-wrap: wrap; }
    .mq ul[aria-hidden] { display: none; }
    .mq ul { flex-wrap: wrap; row-gap: 6px; }
    .track { -webkit-mask-image: none; mask-image: none; padding: 10px 0; }
    .mq li::after { margin: 0 22px; }
  }
  @media (max-width: 760px) {
    .trow { flex-direction: column; }
    .lab { flex-direction: row; align-items: center; justify-content: space-between; min-width: 0; border-right: 0; padding: 16px var(--pad) 0; }
    .lab-more { padding-left: 0; }
  }
</style>

<script>
  // Bouton de pause (WCAG 2.2.2) : affiché seulement avec JavaScript et si le défilement est actif
  document.querySelectorAll<HTMLElement>('.trow').forEach((row) => {
    const btn = row.querySelector<HTMLButtonElement>('.mq-pause');
    if (!btn) return;
    btn.hidden = false;
    const icon = btn.querySelector('use');
    const label = btn.getAttribute('aria-label') ?? '';
    btn.addEventListener('click', () => {
      const paused = row.toggleAttribute('data-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.setAttribute('aria-label', paused ? label.replace('Mettre en pause', 'Reprendre') : label);
      icon?.setAttribute('href', paused ? '#i-play' : '#i-pause');
    });
  });
</script>
