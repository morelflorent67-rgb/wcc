---
/** Carte « situation » de l'espace carrosserie : le visiteur choisit son problème, la carte mène à la prestation. */
import { type CarroService, carroHref, carroQuoteHref } from '../lib/carrosserie';

interface Props { service: CarroService; index: number; }
const { service, index } = Astro.props;
---
<article class="card">
  <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <p class="pb">{service.problem}</p>
  <h3><a href={carroHref(service.slug)}>{service.name}</a></h3>
  <p class="short">{service.short}</p>
  <div class="foot">
    <span class="more">Voir la prestation <svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></span>
    <a class="quote" href={carroQuoteHref(service.intervention)}>Demander un devis</a>
  </div>
</article>

<style>
  .card {
    position: relative; display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 24px 26px 22px;
    background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--orange); border-radius: 18px;
    transition: transform 0.35s var(--ease), box-shadow 0.35s;
  }
  .card:hover, .card:focus-within { transform: translateY(-5px); box-shadow: 0 30px 50px -30px rgba(17, 19, 23, 0.45); }
  .num { font: 800 2.6rem/1 var(--f-display); color: var(--orange-deep); }
  .pb { margin: 0; font: 700 0.78rem/1.2 var(--f-display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--mute); }
  h3 { margin: 0; font: 800 clamp(1.6rem, 2.4vw, 2rem) / 1 var(--f-display); text-transform: uppercase; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: 18px; }
  h3 a:focus-visible { outline: none; }
  h3 a:focus-visible::after { outline: 3px solid var(--orange-deep); outline-offset: 3px; }
  .short { margin: 0; color: var(--mute); font-size: 0.98rem; line-height: 1.45; }
  .foot { margin-top: auto; padding-top: 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px 14px; }
  .more { display: inline-flex; align-items: center; gap: 8px; font: 700 0.92rem var(--f-body); }
  .card:hover .more .ic { transform: translate(2px, -2px); }
  .quote {
    position: relative; z-index: 1; font: 700 0.92rem var(--f-body); color: var(--orange-deep);
    text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px;
  }
</style>
