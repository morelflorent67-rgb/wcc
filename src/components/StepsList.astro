---
/**
 * Déroulement d'une prise en charge, façon « route de nuit » : grand panneau sombre, route en asphalte, voiture
 * dont les phares éclairent la route. Au fil du défilement, la voiture avance et allume chaque étape (borne,
 * poteau, carte) ; à l'arrivée, le drapeau s'agite et le bouton de devis s'illumine.
 * Horizontal sur grand écran, vertical (voiture vue de dessus) dans les colonnes étroites.
 * Sans JavaScript : toutes les étapes sont affichées, sans voiture. Mouvement réduit : voiture garée à l'arrivée.
 *
 * Slot « head » : titre placé dans le panneau. `cta` : bouton affiché en pied de panneau.
 * `icon` d'une étape : symbole de src/components/Icons.astro (sans « i- »), facultatif.
 */
interface Props {
  steps: { title: string; text: string; icon?: string }[];
  accent?: 'orange' | 'blue';
  cta?: { href: string; label: string };
}
const { steps, accent = 'orange', cta } = Astro.props;
const n = steps.length;
const hasHead = Astro.slots.has('head');
const uid = `j${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={['night', accent]} data-journey style={`--n:${n}`}>
  <span class="glow" aria-hidden="true"></span>
  {hasHead && <div class="head"><slot name="head" /></div>}

  <div class="track">
    <ol class="steps">
      {steps.map((st, i) => (
        <li class="step">
          <div class="card">
            <div class="c-top">
              {st.icon
                ? <span class="ico" aria-hidden="true"><svg class="ic"><use href={`#i-${st.icon}`} /></svg></span>
                : <span class="ico dot" aria-hidden="true"></span>}
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3><span class="sr-only">Étape {i + 1} : </span>{st.title}</h3>
            <p>{st.text}</p>
          </div>
          <span class="pole" aria-hidden="true"></span>
          <span class="mark" aria-hidden="true"></span>
        </li>
      ))}
    </ol>

    <div class="road" aria-hidden="true">
      <span class="lines"></span>
      <span class="trail"></span>
      <span class="flag">
        <svg viewBox="0 0 30 44">
          <defs>
            <pattern id={`${uid}-chk`} width="7" height="7" patternUnits="userSpaceOnUse">
              <rect width="7" height="7" fill="#fff" /><rect width="3.5" height="3.5" fill="#15171c" /><rect x="3.5" y="3.5" width="3.5" height="3.5" fill="#15171c" />
            </pattern>
          </defs>
          <path class="flag-pole" d="M4 2v42" />
          <path class="flag-cloth" d="M5 3h21v14H5z" fill={`url(#${uid}-chk)`} />
        </svg>
      </span>
      <span class="car">
        <span class="speed"><i></i><i></i><i></i></span>
        <svg class="side" viewBox="0 0 124 52">
          <defs>
            <linearGradient id={`${uid}-beam`} x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#fff3c4" stop-opacity="0.55" />
              <stop offset="1" stop-color="#fff3c4" stop-opacity="0" />
            </linearGradient>
            <linearGradient id={`${uid}-paint`} x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" class="paint-a" />
              <stop offset="1" class="paint-b" />
            </linearGradient>
          </defs>
          <path class="beam" d="M117 29 230 12v38z" fill={`url(#${uid}-beam)`} />
          <ellipse class="shadow" cx="62" cy="47" rx="56" ry="4" />
          <path class="body" fill={`url(#${uid}-paint)`} d="M8 35c0-6 2-9 8-10l15-3c6-8 13-12 23-12h20c8 0 14 4 20 10l14 3c6 1 9 4 9 9v4c0 2-1 3-3 3H11c-2 0-3-1-3-3z" />
          <path class="win" d="M37 22c5-6 10-9 17-9h7v9zm27 0v-9h9c6 0 10 3 15 9z" />
          <path class="shine" d="M18 27h86" />
          <rect class="tail" x="8.5" y="27" width="3.5" height="4" rx="1.5" />
          <rect class="head-l" x="112" y="27.5" width="4.5" height="3.5" rx="1.5" />
          <g transform="translate(31 40)"><circle class="tyre" r="9" /><circle class="rim" r="5.4" /><path class="spokes" d="M0-5v10M-5 0h10M-3.5-3.5l7 7M3.5-3.5l-7 7" /></g>
          <g transform="translate(95 40)"><circle class="tyre" r="9" /><circle class="rim" r="5.4" /><path class="spokes" d="M0-5v10M-5 0h10M-3.5-3.5l7 7M3.5-3.5l-7 7" /></g>
        </svg>
        <svg class="top" viewBox="0 0 40 78">
          <defs>
            <linearGradient id={`${uid}-beam-v`} x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#fff3c4" stop-opacity="0.5" />
              <stop offset="1" stop-color="#fff3c4" stop-opacity="0" />
            </linearGradient>
            <linearGradient id={`${uid}-paint-v`} x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" class="paint-b" />
              <stop offset="0.5" class="paint-a" />
              <stop offset="1" class="paint-b" />
            </linearGradient>
          </defs>
          <path class="beam" d="M9 72h22l16 80H-7z" fill={`url(#${uid}-beam-v)`} />
          <rect class="tyre" x="1" y="12" width="6" height="14" rx="2.5" /><rect class="tyre" x="33" y="12" width="6" height="14" rx="2.5" />
          <rect class="tyre" x="1" y="50" width="6" height="14" rx="2.5" /><rect class="tyre" x="33" y="50" width="6" height="14" rx="2.5" />
          <rect class="body" x="4" y="2" width="32" height="72" rx="12" fill={`url(#${uid}-paint-v)`} />
          <path class="win" d="M10 13h20l-2.5 7h-15zM9.5 52h21l-3 9h-15z" />
          <rect class="roof" x="10" y="22" width="20" height="28" rx="5" />
          <rect class="head-l" x="8" y="70.5" width="6" height="2.5" rx="1.2" /><rect class="head-l" x="26" y="70.5" width="6" height="2.5" rx="1.2" />
          <rect class="tail" x="8" y="3" width="6" height="2.2" rx="1.1" /><rect class="tail" x="26" y="3" width="6" height="2.2" rx="1.1" />
        </svg>
      </span>
    </div>
  </div>

  <div class="foot">
    <p class="status" aria-hidden="true">
      <span>Étape</span> <b data-cur>{String(n).padStart(2, '0')}</b> <span>/ {String(n).padStart(2, '0')}</span>
      <span class="bar"><i></i></span>
    </p>
    {cta && (
      <a class="cta" href={cta.href}>{cta.label} <i><svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></i></a>
    )}
  </div>
</div>

<style>
  .night {
    --acc: var(--orange); --acc-rgb: 255, 91, 15; --on: #111; --pa: #ff9a52; --pb: #e0430a;
    --p: 1; --c0: 0px; --clen: 0px; --rot: 0deg;
    --pad: clamp(22px, 4vw, 56px);
    position: relative; isolation: isolate; overflow: hidden; container-type: inline-size;
    padding: var(--pad); border-radius: 30px; color: #fff;
    background: linear-gradient(160deg, #15171c 0%, #0d0f12 60%, #0b0c0f 100%);
    box-shadow: 0 50px 90px -50px rgba(17, 19, 23, 0.8);
  }
  .night.blue { --acc: var(--blue); --acc-rgb: 18, 56, 245; --on: #fff; --pa: #6b85ff; --pb: #1238f5; }
  .glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(50% 60% at 0% 0%, rgba(var(--acc-rgb), 0.24), transparent 70%),
      radial-gradient(40% 50% at 100% 100%, rgba(var(--acc-rgb), 0.14), transparent 70%);
  }
  .glow::after {
    content: ''; position: absolute; inset: 0; opacity: 0.5;
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px); background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 70%); mask-image: linear-gradient(to bottom, #000, transparent 70%);
  }

  /* Titre (slot) */
  .head { margin-bottom: clamp(28px, 4vw, 48px); }
  .head :global(.label) { color: #9aa0ab; }
  .head :global(h2) { color: #fff; margin-bottom: 0; }

  /* ---------- Étapes ---------- */
  .track { position: relative; }
  .steps { position: relative; z-index: 1; display: grid; gap: 22px; margin: 0; padding: 0 0 64px 78px; list-style: none; }
  .step { position: relative; }
  .card {
    position: relative; height: 100%; padding: 22px; border-radius: 20px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025));
    border: 1px solid rgba(255, 255, 255, 0.09);
    transition: opacity 0.6s, transform 0.6s var(--ease), border-color 0.6s, box-shadow 0.6s, filter 0.6s;
  }
  .c-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .ico {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px;
    background: rgba(255, 255, 255, 0.08); color: #c9cdd4; transition: background 0.5s, color 0.5s, transform 0.6s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .ico .ic { width: 24px; height: 24px; stroke-width: 1.9; }
  .ico.dot::before { content: ''; width: 12px; height: 12px; border-radius: 50%; background: currentColor; }
  .num {
    font: 800 3.2rem/0.8 var(--f-display); color: transparent; -webkit-text-stroke: 1.3px rgba(255, 255, 255, 0.35);
    transition: color 0.5s, -webkit-text-stroke-color 0.5s;
  }
  h3 { margin: 0 0 8px; font: 800 1.4rem/1.02 var(--f-display); text-transform: uppercase; letter-spacing: 0.01em; }
  .card p { margin: 0; color: #b4b9c2; font-size: 0.98rem; line-height: 1.5; }

  .step.on .card {
    border-color: rgba(var(--acc-rgb), 0.55); transform: translateY(-4px);
    box-shadow: 0 24px 50px -28px rgba(var(--acc-rgb), 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .step.on .ico { background: var(--acc); color: var(--on); transform: rotate(-6deg); }
  .step.on .num { color: #fff; -webkit-text-stroke-color: transparent; }

  /* Poteau et borne (réflecteur au bord de la route) */
  .pole, .mark { position: absolute; z-index: 1; }
  .mark {
    width: 16px; height: 16px; border-radius: 50%; background: #23262d; border: 2px solid #4a505b;
    transition: background 0.4s, border-color 0.4s, box-shadow 0.5s;
  }
  .step.on .mark { background: var(--acc); border-color: #fff; box-shadow: 0 0 0 6px rgba(var(--acc-rgb), 0.25), 0 0 22px 4px rgba(var(--acc-rgb), 0.8); }
  .pole { background: rgba(255, 255, 255, 0.12); overflow: hidden; }
  .pole::after { content: ''; position: absolute; inset: 0; background: var(--acc); transition: transform 0.5s var(--ease); }

  /* ---------- Route ---------- */
  .road { position: absolute; z-index: 0; background: #16181d; }
  .road::before { /* grain de l'asphalte */
    content: ''; position: absolute; inset: 0; opacity: 0.6;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1.2px); background-size: 7px 7px;
  }
  .road::after { content: ''; position: absolute; background: rgba(255, 255, 255, 0.22); }
  .lines, .trail { position: absolute; }
  .flag { position: absolute; z-index: 2; width: 30px; height: 44px; }
  .flag svg { display: block; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.5)); }
  .flag-pole { stroke: #c9cdd4; stroke-width: 2.4; stroke-linecap: round; }
  .flag-cloth { transform-box: fill-box; transform-origin: left center; }
  .car { position: absolute; z-index: 3; display: none; pointer-events: none; }
  .car svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .paint-a { stop-color: var(--pa); }
  .paint-b { stop-color: var(--pb); }
  .body { stroke: rgba(255, 255, 255, 0.4); stroke-width: 0.8; }
  .win { fill: #0f1a2a; opacity: 0.92; }
  .roof { fill: rgba(0, 0, 0, 0.25); }
  .shine { stroke: rgba(255, 255, 255, 0.35); stroke-width: 1.2; stroke-linecap: round; fill: none; }
  .shadow { fill: rgba(0, 0, 0, 0.55); filter: blur(3px); }
  .tail { fill: #ff3b3b; filter: drop-shadow(0 0 3px #ff3b3b); }
  .head-l { fill: #fff6d5; filter: drop-shadow(0 0 4px #fff3c4); }
  .tyre { fill: #121317; }
  .rim { fill: #9aa0ab; }
  .spokes { stroke: #3b3f47; stroke-width: 1.4; transform: rotate(var(--rot)); transform-box: fill-box; transform-origin: center; }
  .speed { position: absolute; opacity: 0; transition: opacity 0.3s; }
  .speed i { position: absolute; border-radius: 2px; }
  .night.moving .speed { opacity: 1; }

  /* ---------- Pied du panneau ---------- */
  .foot { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; margin-top: clamp(26px, 3.4vw, 40px); }
  .status { display: flex; align-items: baseline; gap: 8px; margin: 0; font: 700 0.86rem var(--f-display); letter-spacing: 0.18em; text-transform: uppercase; color: #9aa0ab; }
  .status b { font: 800 1.9rem/1 var(--f-display); letter-spacing: 0.02em; color: #fff; }
  .bar { position: relative; align-self: center; width: clamp(80px, 14vw, 180px); height: 4px; margin-left: 10px; border-radius: 4px; background: rgba(255, 255, 255, 0.12); overflow: hidden; }
  .bar i { position: absolute; inset: 0; background: var(--acc); transform: scaleX(var(--p)); transform-origin: left; }
  .cta {
    display: inline-flex; align-items: center; gap: 14px; padding: 8px 8px 8px 26px; border-radius: 999px; text-decoration: none;
    background: #fff; color: var(--ink); font: 700 1rem var(--f-body); transition: background 0.3s, color 0.3s, box-shadow 0.6s;
  }
  .cta i { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--acc); color: var(--on); font-style: normal; transition: transform 0.3s; }
  .cta:hover { background: var(--acc); color: var(--on); }
  .cta:hover i { background: #fff; color: var(--ink); transform: rotate(45deg); }
  .night.arrived .cta { box-shadow: 0 0 0 6px rgba(var(--acc-rgb), 0.2), 0 18px 40px -12px rgba(var(--acc-rgb), 0.9); }

  /* ============ Vertical (colonnes étroites, mobile) : route à gauche, voiture vue de dessus ============ */
  .road { left: calc(-1 * var(--pad)); top: -12px; bottom: -8px; width: calc(var(--pad) + 54px); border-bottom-right-radius: 14px; }
  .road::after { top: 0; bottom: 0; right: 7px; width: 2px; }
  .lines { top: 0; bottom: 0; left: calc(var(--pad) + 25px); width: 4px; background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.55) 0 18px, transparent 18px 34px); }
  .trail {
    left: calc(var(--pad) + 36px); width: 4px; top: 0; height: max(0px, calc(12px + var(--c0) + var(--p) * var(--clen) - 30px)); border-radius: 4px;
    background: linear-gradient(to bottom, transparent, var(--acc)); box-shadow: 0 0 14px 2px rgba(var(--acc-rgb), 0.55);
  }
  .flag { left: calc(var(--pad) + 16px); bottom: 10px; }
  .pole { left: -24px; top: 33px; width: 24px; height: 2px; }
  .pole::after { transform: scaleX(0); transform-origin: left; }
  .mark { left: -32px; top: 34px; transform: translate(-50%, -50%); }
  .car .side { display: none; }
  :global(.js) .night.ready .car { display: block; width: 34px; height: 66px; left: calc(var(--pad) + 27px); top: calc(12px + var(--c0) + var(--p) * var(--clen)); transform: translate(-50%, -55%); }
  .speed { left: 50%; top: -30px; width: 30px; height: 28px; transform: translateX(-50%); }
  .speed i { width: 2px; height: 18px; background: linear-gradient(transparent, rgba(255, 255, 255, 0.7)); }
  .speed i:nth-child(1) { left: 2px; top: 0; } .speed i:nth-child(2) { left: 14px; top: 8px; } .speed i:nth-child(3) { left: 26px; top: 2px; }
  .step.on .pole::after { transform: none; }

  /* ============ Horizontal (grand écran) : route en pleine largeur sous les étapes ============ */
  @container (min-width: 760px) {
    .steps { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 18px; padding: 0 0 154px; }
    .road { left: calc(-1 * var(--pad)); right: calc(-1 * var(--pad)); top: auto; bottom: 0; width: auto; height: 94px; border-radius: 0; }
    .road::after { top: auto; bottom: 12px; left: 0; right: 0; width: auto; height: 2px; }
    .lines { left: 0; right: 0; top: 46px; bottom: auto; width: auto; height: 4px; background: repeating-linear-gradient(to right, rgba(255, 255, 255, 0.55) 0 30px, transparent 30px 54px); }
    .lines::before { content: ''; position: absolute; left: 0; right: 0; top: -34px; height: 2px; background: rgba(255, 255, 255, 0.22); }
    .trail {
      left: 0; top: 66px; bottom: auto; height: 4px; width: max(0px, calc(var(--pad) + var(--c0) + var(--p) * var(--clen) - 62px));
      background: linear-gradient(90deg, transparent, var(--acc)); box-shadow: 0 0 16px 3px rgba(var(--acc-rgb), 0.55);
    }
    .flag { left: auto; right: calc(var(--pad) - 4px); bottom: auto; top: -40px; }
    .pole { left: 50%; top: auto; bottom: -60px; width: 2px; height: 60px; transform: translateX(-50%); }
    .pole::after { transform: scaleY(0); transform-origin: top; }
    .mark { left: 50%; top: auto; bottom: -68px; transform: translate(-50%, 0); }
    .car .side { display: block; }
    .car .top { display: none; }
    :global(.js) .night.ready .car { width: 140px; height: 59px; left: calc(var(--pad) + var(--c0) + var(--p) * var(--clen)); top: 42px; transform: translate(-50%, -50%); }
    .speed { left: -46px; top: 14px; width: 48px; height: 30px; transform: none; }
    .speed i { width: 40px; height: 2px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7)); }
    .speed i:nth-child(1) { left: 0; top: 4px; } .speed i:nth-child(2) { left: 10px; top: 14px; } .speed i:nth-child(3) { left: 4px; top: 24px; }
  }

  /* Étapes pas encore atteintes : en retrait (avec JavaScript seulement) */
  :global(.js) .night.ready .step:not(.on) .card { opacity: 0.5; filter: saturate(0.5); }
  :global(.js) .night.ready .step:not(.on):hover .card { opacity: 0.85; }

  @media (prefers-reduced-motion: no-preference) {
    .night.arrived .flag-cloth { animation: st-wave 0.9s ease-in-out infinite alternate; }
    .night.moving .speed i { animation: st-zip 0.45s linear infinite; }
    .night.moving .speed i:nth-child(2) { animation-delay: -0.15s; }
    .night.moving .speed i:nth-child(3) { animation-delay: -0.3s; }
    @keyframes st-wave { to { transform: skewY(-8deg) scaleX(0.92); } }
    @keyframes st-zip { from { opacity: 1; } to { opacity: 0.2; } }
  }
</style>

<script>
  // Trajet : la position de la voiture suit le défilement (lissée) ; chaque étape s'allume quand la voiture l'atteint.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const marks = steps.map((s) => s.querySelector<HTMLElement>('.mark')!);
    const road = root.querySelector<HTMLElement>('.road')!;
    const flag = root.querySelector<HTMLElement>('.flag')!;
    const cur = root.querySelector<HTMLElement>('[data-cur]');
    const n = steps.length;
    if (n < 2) { steps.forEach((s) => s.classList.add('on')); return; }

    let horizontal = false;
    let stops: number[] = [];
    let len = 1;
    let target = 0;
    let shown = 0;
    let raf = 0;

    const layout = () => {
      const rr = road.getBoundingClientRect();
      const pad = parseFloat(getComputedStyle(root).paddingLeft) || 0;
      const c = marks.map((m) => { const b = m.getBoundingClientRect(); return { x: b.left + b.width / 2 - rr.left, y: b.top + b.height / 2 - rr.top }; });
      horizontal = Math.abs(c[1].y - c[0].y) < 4;
      // Positions des bornes le long de la route (horizontal : depuis le bord intérieur du panneau ; vertical : depuis le haut de la route + 12 px)
      stops = c.map((p) => (horizontal ? p.x - pad : p.y - 12));
      // Arrivée : la voiture s'arrête juste avant le drapeau, après la dernière borne
      const fr = flag.getBoundingClientRect();
      const finish = horizontal ? fr.left - rr.left - pad - 84 : fr.top - rr.top - 12 - 48;
      len = Math.max(finish, stops[n - 1]) - stops[0] || 1;
      root.style.setProperty('--c0', `${stops[0]}px`);
      root.style.setProperty('--clen', `${len}px`);
      root.classList.add('ready');
    };

    const measure = () => {
      const rr = road.getBoundingClientRect();
      const vh = window.innerHeight;
      target = horizontal
        ? (vh * 1.02 - rr.top) / (vh * 0.34) // trajet complet pendant que la route remonte du bas de l'écran à 68 % de sa hauteur
        : (vh * 0.8 - (rr.top + 12 + stops[0])) / len; // ligne de lecture à 80 % de l'écran : la voiture devance la lecture
      target = Math.min(1, Math.max(0, target));
      if (!raf) raf = requestAnimationFrame(tick);
    };

    const apply = () => {
      root.style.setProperty('--p', shown.toFixed(4));
      root.style.setProperty('--rot', `${(shown * len * 4).toFixed(1)}deg`);
      const dist = shown * len;
      let on = 0;
      steps.forEach((s, i) => {
        const lit = dist >= stops[i] - stops[0] - 2;
        s.classList.toggle('on', lit);
        if (lit) on = i + 1;
      });
      if (cur) cur.textContent = String(Math.max(on, 1)).padStart(2, '0');
      root.classList.toggle('arrived', shown >= 0.995);
    };

    const tick = () => {
      const delta = target - shown;
      shown += delta * 0.16;
      if (Math.abs(delta) < 0.0008) shown = target;
      root.classList.toggle('moving', Math.abs(delta) > 0.004);
      apply();
      raf = shown === target ? 0 : requestAnimationFrame(tick);
      if (!raf) root.classList.remove('moving');
    };

    const refresh = () => { layout(); if (reduce) { shown = target = 1; apply(); } else measure(); };
    refresh();
    document.fonts?.ready.then(refresh);
    if (!reduce) window.addEventListener('scroll', measure, { passive: true });
    let rt: number | undefined;
    window.addEventListener('resize', () => { window.clearTimeout(rt); rt = window.setTimeout(refresh, 120); });
    if ('ResizeObserver' in window) new ResizeObserver(() => refresh()).observe(root);
  });
</script>
