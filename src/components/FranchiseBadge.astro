---
/**
 * Fanion « Franchise offerte » (choix du client, 23 octobre 2026 : version compacte, proposition B ; prototype : design/prototypes/franchise-compact.html).
 * Bandeau orange qui sort du bord gauche, coin coupé. Portail (moitié carrosserie) et accueil carrosserie, dans le flux au-dessus du titre :
 * il ne chevauche jamais le texte. La phrase explicative (site.json → franchise.text) n'est plus affichée ici : elle sert de nom accessible.
 * Masqué si franchise.enabled = false. L'appelant peut surcharger --bleed (retrait à gauche) pour atteindre le bord de l'écran.
 */
import site from '../data/site.json';
const franchise = site.franchise;

interface Props { class?: string }
const { class: cls } = Astro.props;
---
{franchise?.enabled && (
  <span class:list={['fr-wrap', cls]} role="img" aria-label={`${franchise.line1} ${franchise.line2} : ${franchise.text}`}>
    <span class="fr-flag" aria-hidden="true">
      <svg class="ic"><use href="#i-shield" /></svg>
      <span class="t">{franchise.line1} {franchise.line2}</span>
    </span>
  </span>
)}

<style>
  .fr-wrap { display: block; width: fit-content; margin-left: calc(-1 * var(--bleed, var(--pad))); filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.35)); }
  .fr-flag {
    display: inline-flex; align-items: center; gap: 9px; height: 36px; padding: 0 26px 0 var(--bleed, var(--pad)); color: #fff;
    background: linear-gradient(135deg, #ffa63d 0%, var(--orange) 45%, var(--orange-deep) 100%);
    clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 100%, 0 100%);
  }
  .fr-flag .ic { width: 18px; height: 18px; flex: none; }
  .t { font: 800 1.2rem / 1 var(--f-display); letter-spacing: 0.05em; text-transform: uppercase; white-space: nowrap; }
</style>
