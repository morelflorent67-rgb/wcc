---
/**
 * Pastille « Franchise offerte » (portail, moitié carrosserie ; accueil carrosserie). Texte : site.json → franchise ;
 * masquée si franchise.enabled = false. Même contour que le macaron mécanique (PromoSticker), en blanc pour ressortir sur l'orange.
 */
import site from '../data/site.json';
const franchise = site.franchise;

interface Props { class?: string }
const { class: cls } = Astro.props;

// Contour en dents de scie : 22 pointes, rayons alternés
const pts: string[] = [];
const n = 22;
for (let i = 0; i < n * 2; i++) {
  const a = (Math.PI * i) / n - Math.PI / 2;
  const r = i % 2 === 0 ? 98 : 88;
  pts.push(`${(100 + r * Math.cos(a)).toFixed(1)},${(100 + r * Math.sin(a)).toFixed(1)}`);
}
---
{franchise?.enabled && (
  <div class:list={['badge', cls]} role="img" aria-label={`${franchise.line1} ${franchise.line2}`}>
    <svg viewBox="0 0 200 200" aria-hidden="true" focusable="false">
      <polygon class="star" points={pts.join(' ')} />
      <circle class="ring" cx="100" cy="100" r="76" />
      <path class="shield" d="M100 42 l17 6.5 v12 c0 11 -7.5 19 -17 22.5 c-9.5 -3.5 -17 -11.5 -17 -22.5 v-12 z" />
      <path class="tick" d="M92.5 61.5 l5.5 5.5 l10 -11" />
      <text class="l1" x="100" y="117" text-anchor="middle">{franchise.line1.toUpperCase()}</text>
      <text class="l2" x="100" y="156" text-anchor="middle">{franchise.line2.toUpperCase()}</text>
    </svg>
  </div>
)}

<style>
  .badge { width: clamp(118px, 15vw, 190px); transform: rotate(-9deg); filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.4)); }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .star { fill: #fff; }
  .ring { fill: none; stroke: var(--orange-deep); stroke-width: 2.2; stroke-dasharray: 3 5; }
  .shield { fill: var(--orange); }
  .tick { fill: none; stroke: #fff; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  text { font-family: var(--f-display); font-weight: 800; }
  .l1 { fill: var(--ink); font-size: 28px; letter-spacing: 0.04em; }
  .l2 { fill: var(--orange-deep); font-size: 37px; letter-spacing: 0.05em; }
  @media (prefers-reduced-motion: no-preference) {
    .badge { animation: fr-wob 5s ease-in-out infinite; }
    @keyframes fr-wob { 50% { transform: rotate(-5deg) scale(1.04); } }
  }
</style>
