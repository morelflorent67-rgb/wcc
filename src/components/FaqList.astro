---
/** Questions fréquentes en accordéon (éléments <details> natifs : fonctionnent sans JavaScript). */
interface Props { items: { q: string; a: string }[]; accent?: 'orange' | 'blue'; }
const { items, accent = 'orange' } = Astro.props;
---
<div class:list={['faq', accent]}>
  {items.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { --acc-text: var(--orange-deep); display: grid; border-top: 1.5px solid var(--ink); }
  .faq.blue { --acc-text: var(--blue); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; padding: 20px 0; font: 700 1.12rem/1.3 var(--f-body); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex: none; font: 400 1.7rem/1 var(--f-body); color: var(--acc-text); }
  details[open] summary::after { content: '–'; }
  p { margin: 0 0 22px; max-width: 62ch; color: var(--ink-soft); line-height: 1.6; }
</style>
