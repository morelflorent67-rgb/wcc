---
/**
 * Avis clients : défilement latéral automatique (pause, précédent, suivant, balayage tactile).
 * Données : src/data/reviews.json. Tant que le fichier est vide, des cartes « à intégrer » s'affichent
 * (aucun avis n'est inventé). Chaque avis : { author, date, rating?, text }.
 */
import data from '../data/reviews.json';

interface Review { author: string; date?: string; rating?: number; text: string; }
const list = (data.items ?? []) as Review[];
const captured = new Date(data.capturedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const placeholders = Array.from({ length: 10 }, (_, i) => i);
const empty = list.length === 0;
const initial = (s: string) => s.trim().charAt(0).toUpperCase();
---
<section class="reviews" data-reviews aria-labelledby="avis-t">
  <p class="label reveal">Avis clients</p>
  <h2 id="avis-t" class="reveal">Votre confiance nous fait avancer.</h2>

  <div class="stage reveal" style="--d:.1s">
    <div class="rail" data-rail tabindex="0" role="region" aria-label="Avis clients — faites défiler horizontalement">
      <ul class="track" data-track>
        {empty
          ? placeholders.map((i) => (
              <li class="rcard ph">
                <span class="tag">Avis Google</span>
                <div class="sk" style={`width:${[92, 78, 88, 70, 84][i % 5]}%`}></div>
                <div class="sk" style={`width:${[64, 90, 72, 86, 60][i % 5]}%`}></div>
                <div class="sk" style={`width:${[80, 58, 76, 66, 90][i % 5]}%`}></div>
                <div class="who"><span class="sk-c"></span><span class="sk-who"><i></i><i></i></span></div>
              </li>
            ))
          : list.map((r) => (
              <li class="rcard">
                <header class="who">
                  <span class="avatar" aria-hidden="true">{initial(r.author)}</span>
                  <span class="who-t"><b>{r.author}</b>{r.date && <small>{r.date}</small>}</span>
                </header>
                {r.rating && (
                  <div class="stars" role="img" aria-label={`${r.rating} sur 5`}>
                    {Array.from({ length: 5 }, (_, n) => (
                      <svg class:list={['ic', { off: n >= (r.rating ?? 0) }]} aria-hidden="true"><use href="#i-star" /></svg>
                    ))}
                  </div>
                )}
                <blockquote><p class="rtext">{r.text}</p></blockquote>
                <button type="button" class="more" hidden aria-expanded="false">Lire la suite</button>
                <p class="src">Avis Google</p>
              </li>
            ))}
      </ul>
    </div>

    <div class="ctrls" aria-label="Commandes du défilement des avis">
      <button type="button" data-prev aria-label="Avis précédents"><svg class="ic" aria-hidden="true"><use href="#i-left" /></svg></button>
      <button type="button" data-toggle aria-label="Mettre le défilement en pause"><svg class="ic" aria-hidden="true"><use href="#i-pause" data-toggle-icon /></svg></button>
      <button type="button" data-next aria-label="Avis suivants"><svg class="ic" aria-hidden="true"><use href="#i-right" /></svg></button>
    </div>
  </div>

  {empty
    ? <p class="rnote reveal">Sélection d’avis Google à intégrer. Aucun avis, note ou témoignage n’est inventé.</p>
    : <p class="rnote reveal">Sélection d’avis publiés sur Google, relevés le {captured}.</p>}
</section>

<style>
  .reviews { padding: clamp(60px, 9vw, 120px) 0; text-align: center; overflow: hidden; }
  .label { color: var(--mute); margin: 0; }
  h2 {
    margin: 14px auto 40px; padding-inline: var(--pad); max-width: 15ch;
    font: 800 clamp(2.8rem, 7.4vw, 6.4rem) / 0.88 var(--f-display); text-transform: uppercase; letter-spacing: -0.005em;
  }
  .rail {
    overflow-x: auto; scrollbar-width: none; padding: 6px var(--pad) 14px; text-align: left;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .rail::-webkit-scrollbar { display: none; }
  .track { display: flex; gap: 16px; width: max-content; margin: 0; padding: 0; list-style: none; }
  .rcard {
    flex: none; width: min(340px, 78vw); min-height: 250px; display: flex; flex-direction: column; gap: 12px;
    background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 24px 24px 22px;
    box-shadow: 0 18px 40px -30px rgba(17, 19, 23, 0.4);
  }
  .tag { font: 700 0.74rem/1 var(--f-display); letter-spacing: 0.18em; text-transform: uppercase; color: var(--mute); margin-bottom: 6px; display: flex; align-items: center; gap: 8px; }
  .tag::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--grad); }
  .sk { height: 11px; border-radius: 6px; background: linear-gradient(90deg, #eeeae3, #f8f5f0, #eeeae3); background-size: 200% 100%; }
  .who { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 10px; }
  .sk-c { width: 40px; height: 40px; border-radius: 50%; background: #eeeae3; flex: none; }
  .sk-who { display: grid; gap: 7px; flex: 1; }
  .sk-who i { display: block; height: 9px; border-radius: 5px; background: #eeeae3; }
  .sk-who i:first-child { width: 55%; }
  .sk-who i:last-child { width: 35%; }
  @media (prefers-reduced-motion: no-preference) { .sk { animation: shimmer 2.4s linear infinite; } }
  @keyframes shimmer { to { background-position: -200% 0; } }

  /* Avis réels */
  .rcard:not(.ph) { gap: 14px; }
  .rcard:not(.ph) .who { margin: 0; padding: 0; }
  .avatar { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; flex: none; background: var(--ink); color: #fff; font: 700 1.1rem var(--f-display); }
  .who-t { display: grid; line-height: 1.2; text-align: left; }
  .who-t b { font-weight: 600; }
  .who-t small { color: var(--mute); font-size: 0.82rem; }
  .stars { display: flex; gap: 2px; color: #f5a300; }
  .stars .ic { fill: currentColor; stroke: none; width: 18px; height: 18px; }
  .stars .off { color: #ddd6c8; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font-size: 1.04rem; line-height: 1.5; color: var(--ink-soft); }
  .rtext { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 8; line-clamp: 8; overflow: hidden; }
  .rcard.open .rtext { display: block; -webkit-line-clamp: unset; line-clamp: unset; }
  .more { align-self: flex-start; padding: 0; background: none; border: 0; cursor: pointer; font: 700 0.9rem var(--f-body); color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .more[hidden] { display: none; }
  .more:hover { color: var(--blue); }
  .src { margin: auto 0 0; font: 700 0.74rem/1 var(--f-display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--mute); }

  .ctrls { display: none; justify-content: center; gap: 10px; margin-top: 18px; }
  :global(.js) .ctrls { display: flex; }
  .ctrls button {
    display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; cursor: pointer;
    background: #fff; color: var(--ink); border: 1.5px solid var(--ink); transition: background 0.25s, color 0.25s;
  }
  .ctrls button:hover { background: var(--ink); color: #fff; }
  .rnote { margin: 18px auto 0; padding-inline: var(--pad); font-size: 0.92rem; color: var(--mute); }
</style>

<script>
  // Défilement latéral automatique des avis (boucle infinie, pause, commandes manuelles).
  function init(root: HTMLElement) {
    const rail = root.querySelector<HTMLElement>('[data-rail]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const toggleIcon = root.querySelector<SVGUseElement>('[data-toggle-icon]')!;
    const originals = [...track.children] as HTMLElement[];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Boucle : on duplique les cartes (copies masquées aux lecteurs d'écran)
    const loop = originals.length >= 3;
    if (loop) {
      originals.forEach((li) => {
        const c = li.cloneNode(true) as HTMLElement;
        c.setAttribute('aria-hidden', 'true');
        c.setAttribute('inert', '');
        track.appendChild(c);
      });
    }
    const half = () => track.scrollWidth / 2;

    let paused = reduce;
    let hold = false;
    let holdTimer: number | undefined;
    let pos = rail.scrollLeft;
    let last = performance.now();
    const SPEED = 42; // pixels par seconde

    const setPaused = (p: boolean) => {
      paused = p;
      toggle.setAttribute('aria-label', p ? 'Reprendre le défilement automatique' : 'Mettre le défilement en pause');
      toggleIcon.setAttribute('href', p ? '#i-play' : '#i-pause');
    };
    setPaused(paused);

    const release = () => { hold = false; pos = rail.scrollLeft; };
    const holdFor = (ms: number) => {
      hold = true;
      window.clearTimeout(holdTimer);
      holdTimer = window.setTimeout(release, ms);
    };

    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      if (loop && !paused && !hold && !document.hidden) {
        pos += SPEED * dt;
        const h = half();
        if (pos >= h) pos -= h;
        rail.scrollLeft = pos;
      }
      requestAnimationFrame(frame);
    }

    rail.addEventListener('scroll', () => {
      if (!loop) return;
      const h = half();
      // Boucle invisible aussi pour le défilement manuel
      if (rail.scrollLeft >= h) rail.scrollLeft -= h;
      else if (rail.scrollLeft <= 1) rail.scrollLeft += h;
      if (Math.abs(rail.scrollLeft - pos) > 3) pos = rail.scrollLeft;
    }, { passive: true });

    rail.addEventListener('pointerenter', () => { hold = true; window.clearTimeout(holdTimer); });
    rail.addEventListener('pointerleave', release);
    rail.addEventListener('focusin', () => { hold = true; window.clearTimeout(holdTimer); });
    rail.addEventListener('focusout', release);
    rail.addEventListener('touchstart', () => { hold = true; window.clearTimeout(holdTimer); }, { passive: true });
    rail.addEventListener('touchend', () => holdFor(2500), { passive: true });

    const step = () => (originals[0]?.offsetWidth ?? 340) + 16;
    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      holdFor(4000);
      rail.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' });
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      holdFor(4000);
      rail.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' });
    });
    toggle.addEventListener('click', () => setPaused(!paused));

    // Avis longs : bouton « Lire la suite » affiché seulement si le texte est tronqué
    const cards = () => [...track.children] as HTMLElement[];
    const measure = () => {
      for (const c of cards()) {
        const t = c.querySelector<HTMLElement>('.rtext');
        const b = c.querySelector<HTMLButtonElement>('.more');
        if (!t || !b) continue;
        b.hidden = !c.classList.contains('open') && t.scrollHeight <= t.clientHeight + 1;
      }
    };
    track.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.more');
      if (!btn) return;
      const all = cards();
      const i = all.indexOf(btn.closest('.rcard') as HTMLElement) % originals.length;
      const open = !all[i].classList.contains('open');
      for (const c of [all[i], all[i + originals.length]].filter(Boolean)) {
        c.classList.toggle('open', open);
        const b = c.querySelector<HTMLButtonElement>('.more');
        if (b) { b.textContent = open ? 'Réduire' : 'Lire la suite'; b.setAttribute('aria-expanded', String(open)); }
      }
      holdFor(open ? 20000 : 2000);
    });
    measure();
    document.fonts?.ready.then(measure);
    let rt: number | undefined;
    window.addEventListener('resize', () => { window.clearTimeout(rt); rt = window.setTimeout(measure, 150); });

    if (loop) rail.scrollLeft = 1;
    requestAnimationFrame((t) => { last = t; requestAnimationFrame(frame); });
  }
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach(init);
</script>
