---
import { type Service, formatPrice, serviceHref, quoteHref, families } from '../lib/mecanique';

interface Props { service: Service; showFamily?: boolean; }
const { service, showFamily = false } = Astro.props;
const family = families.find((f) => f.id === service.family);
---
<article class="card">
  {showFamily && <p class="fam">{family?.name}</p>}
  <h3><a href={serviceHref(service.slug)}>{service.name}</a></h3>
  <p class="short">{service.short}</p>
  <div class="foot">
    {service.priceFrom === null
      ? <p class="price"><b class="devis">Sur devis</b></p>
      : <p class="price"><small>À partir de</small><b>{formatPrice(service.priceFrom)}</b></p>}
    <a class="quote" href={quoteHref(service.slug)}>Demander un devis <svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></a>
  </div>
</article>

<style>
  .card {
    position: relative; display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 26px 26px 22px;
    background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--blue); border-radius: 18px;
    transition: transform 0.35s var(--ease), box-shadow 0.35s, border-color 0.3s;
  }
  .card:hover, .card:focus-within { transform: translateY(-5px); box-shadow: 0 30px 50px -30px rgba(17, 19, 23, 0.45); }
  .fam { margin: 0; font: 700 0.74rem/1 var(--f-display); letter-spacing: 0.18em; text-transform: uppercase; color: var(--mute); }
  h3 { margin: 0; font: 800 clamp(1.6rem, 2.4vw, 2rem) / 1 var(--f-display); text-transform: uppercase; letter-spacing: 0.005em; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: 18px; }
  h3 a:focus-visible { outline: none; }
  h3 a:focus-visible::after { outline: 3px solid var(--blue); outline-offset: 3px; }
  .short { margin: 0; color: var(--mute); font-size: 0.98rem; line-height: 1.45; }
  .foot { margin-top: auto; padding-top: 14px; display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .price { margin: 0; display: grid; line-height: 1.05; }
  .price small { font-size: 0.8rem; color: var(--mute); }
  .price b { font: 800 2.1rem/1 var(--f-display); letter-spacing: 0.01em; }
  .price .devis { font-size: 1.5rem; color: var(--ink-soft); }
  .quote {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 8px; font: 700 0.92rem var(--f-body);
    color: var(--blue); text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px;
  }
  .quote:hover .ic { transform: translate(2px, -2px); }
</style>
