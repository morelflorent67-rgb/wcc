---
/**
 * Carte animée de l'accès au garage (bloc « Accès & horaires » et page /acces-horaires/).
 * Dessinée par tools/build_map.py à partir des données OpenStreetMap : aucun service tiers, aucun cookie.
 * Animation à l'apparition (zoom, rues qui se tracent, repère, trajet depuis le tram) ; statique si mouvement réduit.
 */
import { Image } from 'astro:assets';
import fond from '../assets/map/acces-fond.svg?url';
import logoMark from '../assets/brand/logo-wcc-mark.webp';
import map from '../data/map-acces.json';
import site from '../data/site.json';

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;

const [, , vw, vh] = map.viewBox.split(' ').map(Number);
const g = map.garage;
const route = map.route;
const walk = route ? Math.round(route.meters / 100) * 100 : null;
// Barre d'échelle : 200 m en pourcentage de la largeur
const scalePct = (200 / map.metersPerUnit / vw) * 100;
const uid = `m${Math.random().toString(36).slice(2, 8)}`;
---
<figure class:list={['map', { compact }]} data-map style={`--px:${g.px}%;--py:${g.py}%;--ar:${vw}/${vh}`}>
  <div class="frame">
    <div class="cam">
      <img class="base" src={fond} alt="" width={vw} height={vh} loading="lazy" decoding="async" />
      <svg class="over" viewBox={map.viewBox} aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id={`${uid}-route`} gradientUnits="userSpaceOnUse" x1={route?.x ?? 0} y1={route?.y ?? 0} x2={g.x} y2={g.y}>
            <stop offset="0" stop-color="#b57bff" />
            <stop offset="0.55" stop-color="#ff4f8a" />
            <stop offset="1" stop-color="#ff7a2a" />
          </linearGradient>
          <radialGradient id={`${uid}-glow`}>
            <stop offset="0" stop-color="#ff6a2a" stop-opacity="0.55" />
            <stop offset="1" stop-color="#ff6a2a" stop-opacity="0" />
          </radialGradient>
        </defs>
        <g class="roads">
          {map.roads.map((r, i) => (
            <path d={r.d} pathLength="1" stroke-width={r.w} class={r.cls} style={`--i:${Math.min(i, 30)}`} />
          ))}
        </g>
        <path class="street" d={map.street} pathLength="1" />
        <g class="tram">{map.tram.map((d) => <path d={d} pathLength="1" />)}</g>
        {route && (
          <g class="route">
            <path class="route-draw" d={route.d} pathLength="1" stroke={`url(#${uid}-route)`} />
            <path class="route-flow" d={route.d} />
            <circle class="stop" cx={route.x} cy={route.y} r="13" />
          </g>
        )}
        <circle class="glow" cx={g.x} cy={g.y} r="190" fill={`url(#${uid}-glow)`} />
        <g class="radar" transform={`translate(${g.x} ${g.y})`}>
          <circle r="80" /><circle r="80" /><circle r="80" />
        </g>
        <circle class="dot" cx={g.x} cy={g.y} r="15" />
      </svg>

      {map.labels.map((l) => (
        <span class="lbl" style={`left:${l.x}%;top:${l.y}%;--a:${l.angle}deg`} aria-hidden="true">{l.text}</span>
      ))}
      {route && (
        <span class="lbl stop-lbl" style={`left:${(100 * route.x) / vw}%;top:${(100 * route.y) / vh}%`} aria-hidden="true">
          <i>B</i>{route.stop}
        </span>
      )}
      <span class="tag" aria-hidden="true">
        <Image src={logoMark} alt="" width={64} height={19} densities={[1, 2]} />
      </span>
    </div>

    <span class="compass" aria-hidden="true">N</span>
    <span class="scale" aria-hidden="true" style={`--w:${scalePct}%`}><i></i>200 m</span>
    <a class="attr" href="https://www.openstreetmap.org/copyright" rel="noopener">© contributeurs OpenStreetMap</a>
  </div>

  <figcaption class="card">
    <p class="c-name">{site.name}</p>
    <p class="c-adr">{site.address.street}, {site.address.postalCode} {site.address.city}</p>
    {route && walk && (
      <p class="c-tram"><i aria-hidden="true">B</i>Tram B, arrêt {route.stop} : environ {walk} m à pied</p>
    )}
    <div class="c-acts">
      <a class="go" href={site.directionsUrl} rel="noopener">Itinéraire Google Maps <svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></a>
      <a class="go alt" href={site.wazeUrl} rel="noopener">Waze <svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></a>
    </div>
  </figcaption>
</figure>

<style>
  .map { position: relative; margin: 0; display: grid; gap: 14px; }
  .frame {
    position: relative; aspect-ratio: var(--ar); overflow: hidden; border-radius: 26px; background: #14171c; isolation: isolate; container-type: inline-size;
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  /* Liseré dégradé du logo, au-dessus de la carte */
  .frame::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1.5px; pointer-events: none; z-index: 4;
    background: linear-gradient(130deg, rgba(255, 138, 16, 0.75), rgba(199, 43, 71, 0.15) 35%, rgba(59, 13, 201, 0.12) 65%, rgba(0, 160, 255, 0.7));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  .cam { position: absolute; inset: 0; transform-origin: var(--px) var(--py); }
  .base, .over { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .base { object-fit: cover; }
  .over { overflow: visible; }

  .roads path { fill: none; stroke: #3b4049; stroke-linecap: round; stroke-linejoin: round; }
  .roads .primary, .roads .secondary { stroke: #4a505b; }
  .street { fill: none; stroke: #6b717c; stroke-width: 10; stroke-linecap: round; stroke-linejoin: round; }
  .tram path { fill: none; stroke: #8f6bff; stroke-width: 5; stroke-linecap: round; opacity: 0.85; }
  .route-draw { fill: none; stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; opacity: 0.95; }
  .route-flow { fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 2 22; opacity: 0.85; }
  .stop { fill: #8f6bff; stroke: #fff; stroke-width: 5; }
  .dot { fill: #ff5b0f; stroke: #fff; stroke-width: 6; }
  .radar circle { fill: none; stroke: #ff7a2a; stroke-width: 3; opacity: 0; transform-box: fill-box; transform-origin: center; }

  .lbl {
    position: absolute; z-index: 2; transform: translate(-50%, -50%) rotate(var(--a, 0deg)); white-space: nowrap; pointer-events: none;
    font: 700 clamp(0.5rem, 1.45cqi, 0.7rem) / 1 var(--f-display); letter-spacing: 0.16em; text-transform: uppercase; color: #a3a9b4;
    text-shadow: 0 0 4px #14171c, 0 0 8px #14171c;
  }
  .stop-lbl {
    display: inline-flex; align-items: center; gap: 7px; transform: translate(-14px, 16px); letter-spacing: 0.08em;
    padding: clamp(3px, 0.7cqi, 5px) 9px clamp(3px, 0.7cqi, 5px) clamp(3px, 0.7cqi, 5px); border-radius: 999px; background: rgba(20, 23, 28, 0.85); color: #e9ebef; text-shadow: none;
    border: 1px solid rgba(143, 107, 255, 0.5);
  }
  .stop-lbl i { width: clamp(13px, 2.4cqi, 18px) !important; height: clamp(13px, 2.4cqi, 18px) !important; font-size: clamp(0.55rem, 1.4cqi, 0.72rem) !important; }
  .stop-lbl i, .c-tram i {
    display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #8f6bff; color: #fff;
    font: 800 0.72rem/1 var(--f-display); font-style: normal; letter-spacing: 0;
  }
  .tag {
    position: absolute; z-index: 3; left: var(--px); top: var(--py); transform: translate(-50%, calc(-100% - 22px));
    display: grid; place-items: center; padding: clamp(5px, 1.2cqi, 9px) clamp(7px, 1.6cqi, 12px); border-radius: clamp(8px, 1.6cqi, 12px); background: #fff;
    box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.7);
  }
  .tag::after {
    content: ''; position: absolute; left: 50%; bottom: -6px; width: 12px; height: 12px; background: #fff; transform: translateX(-50%) rotate(45deg); border-radius: 2px;
  }
  .tag :global(img) { position: relative; z-index: 1; width: clamp(38px, 8.6cqi, 64px); height: auto; }

  .compass, .scale, .attr { position: absolute; z-index: 3; color: #c9cdd4; }
  .compass {
    top: 14px; right: 14px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    background: rgba(20, 23, 28, 0.8); border: 1px solid rgba(255, 255, 255, 0.14); font: 800 0.8rem/1 var(--f-display);
  }
  .compass::before { content: ''; position: absolute; top: 3px; width: 0; height: 0; border: 4px solid transparent; border-bottom: 6px solid #ff5b0f; border-top: 0; }
  .scale { top: 18px; left: 16px; display: grid; gap: 5px; width: var(--w); font: 700 0.66rem/1 var(--f-display); letter-spacing: 0.12em; }
  .scale i { display: block; height: 5px; border: 1.5px solid #c9cdd4; border-top: 0; }
  .attr { right: 8px; bottom: 6px; display: inline-flex; align-items: center; min-height: 24px; font-size: 0.68rem; color: #9aa0ab; text-decoration: none; padding: 2px 8px; border-radius: 8px; background: rgba(20, 23, 28, 0.75); }
  .attr:hover { color: #fff; text-decoration: underline; }

  /* Carte d'adresse : posée sur la carte sur grand écran, dessous sur mobile */
  .card { display: grid; gap: 6px; padding: 18px 20px; border-radius: 18px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); color: #fff; }
  .card p { margin: 0; }
  /* Couleurs explicites : la carte est aussi posée dans des pages au texte sombre (page Accès) */
  .card .c-name { font: 800 1.25rem/1.05 var(--f-display); text-transform: uppercase; letter-spacing: 0.02em; color: #fff; }
  .card .c-adr { color: #c9cdd4; }
  .card .c-tram { display: flex; align-items: center; gap: 8px; color: #c9cdd4; font-size: 0.92rem; }
  .c-acts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .go {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; text-decoration: none;
    font: 700 0.9rem var(--f-body); background: #fff; color: var(--ink); transition: background 0.25s, color 0.25s;
  }
  .go.alt { background: transparent; color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.4); }
  .go:hover { background: var(--orange); color: #111; border-color: var(--orange); }
  .go:hover .ic { transform: translate(2px, -2px); }
  @media (min-width: 760px) {
    .map:not(.compact) .card {
      position: absolute; z-index: 5; left: 18px; bottom: 18px; max-width: min(380px, 60%);
      background: rgba(15, 17, 20, 0.72); -webkit-backdrop-filter: blur(14px) saturate(1.3); backdrop-filter: blur(14px) saturate(1.3);
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.8);
    }
  }
  .compact .card { background: var(--night); }

  /* --- Animation (seulement avec JavaScript et sans demande de réduction des mouvements) --- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cam { transform: scale(1.5); transition: transform 2.6s cubic-bezier(0.16, 0.8, 0.2, 1); }
    :global(.js) .base { opacity: 0; filter: blur(6px); transition: opacity 1.2s, filter 1.6s; }
    :global(.js) .roads path, :global(.js) .street, :global(.js) .tram path, :global(.js) .route-draw {
      stroke-dasharray: 1 2; stroke-dashoffset: 1; opacity: 0;
    }
    :global(.js) .route-flow, :global(.js) .stop, :global(.js) .dot, :global(.js) .glow, :global(.js) .lbl, :global(.js) .tag { opacity: 0; }

    .map.is-in .cam { transform: none; }
    .map.is-in .base { opacity: 1; filter: none; }
    .map.is-in .roads path {
      stroke-dashoffset: 0; opacity: 1;
      transition: stroke-dashoffset 1.8s cubic-bezier(0.5, 0, 0.2, 1) calc(0.25s + var(--i) * 45ms), opacity 0.1s calc(0.25s + var(--i) * 45ms);
    }
    .map.is-in .street { stroke-dashoffset: 0; opacity: 1; transition: stroke-dashoffset 1.2s var(--ease) 0.9s, opacity 0.1s 0.9s; }
    .map.is-in .tram path { stroke-dashoffset: 0; opacity: 0.85; transition: stroke-dashoffset 1.6s var(--ease) 1.1s, opacity 0.1s 1.1s; }
    .map.is-in .route-draw { stroke-dashoffset: 0; opacity: 0.95; transition: stroke-dashoffset 2s cubic-bezier(0.6, 0, 0.3, 1) 1.9s, opacity 0.1s 1.9s; }
    .map.is-in .route-flow { opacity: 0.85; transition: opacity 0.6s 3.8s; animation: map-flow 1.4s linear infinite; }
    .map.is-in .stop { opacity: 1; transition: opacity 0.4s 1.8s; }
    .map.is-in .glow { opacity: 1; transition: opacity 1s 1.4s; }
    .map.is-in .dot { opacity: 1; transition: opacity 0.3s 1.5s; }
    .map.is-in .lbl { opacity: 1; transition: opacity 0.8s 1.6s; }
    .map.is-in .radar circle { animation: map-radar 3s cubic-bezier(0.2, 0.6, 0.3, 1) infinite; }
    .map.is-in .radar circle:nth-child(2) { animation-delay: 1s; }
    .map.is-in .radar circle:nth-child(3) { animation-delay: 2s; }
    .map.is-in .tag { animation: map-drop 0.9s cubic-bezier(0.3, 1.5, 0.5, 1) 1.7s both; }
    @keyframes map-flow { to { stroke-dashoffset: -24; } }
    @keyframes map-radar { 0% { transform: scale(0.12); opacity: 0.9; } 100% { transform: scale(1); opacity: 0; } }
    @keyframes map-drop { from { opacity: 0; transform: translate(-50%, calc(-100% - 70px)); } to { opacity: 1; transform: translate(-50%, calc(-100% - 22px)); } }
    /* Léger effet de profondeur au survol (souris) */
    .frame { transition: transform 0.6s var(--ease); }
  }
  @media (prefers-reduced-motion: reduce) {
    .radar circle:first-child { opacity: 0.5; transform: scale(0.45); }
  }
</style>

<script>
  // Apparition de la carte (zoom puis tracé des rues) quand elle entre à l'écran, et léger relief au survol
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((el) => {
    if (!('IntersectionObserver' in window)) { el.classList.add('is-in'); return; }
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { el.classList.add('is-in'); io.disconnect(); }
    }, { threshold: 0.3 });
    io.observe(el);

    const frame = el.querySelector<HTMLElement>('.frame');
    if (!frame || matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(hover: hover)').matches) return;
    frame.addEventListener('pointermove', (e) => {
      const r = frame.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      frame.style.transform = `perspective(1200px) rotateX(${(-y * 4).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg)`;
    });
    frame.addEventListener('pointerleave', () => { frame.style.transform = ''; });
  });
</script>
