---
import Base from './Base.astro';
import SpaceHeader from '../components/SpaceHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  space: 'mecanique' | 'carrosserie';
  title: string;
  description: string;
  /** Adresse de la page courante, pour la navigation (aria-current) */
  current?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { space, title, description, current, jsonLd, noindex } = Astro.props;
---
<Base title={title} description={description} jsonLd={jsonLd} noindex={noindex}>
  <SpaceHeader space={space} current={current ?? Astro.url.pathname} />
  <main id="contenu"><slot /></main>
  <SiteFooter />
</Base>
