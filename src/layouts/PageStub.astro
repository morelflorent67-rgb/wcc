---
import Base from './Base.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props { title: string; section?: string; }
const { title, section } = Astro.props;
---
<Base title={`${title} — World Car Carrosserie`} description="Page en cours de construction." noindex>
  <main id="contenu" class="stub">
    <p class="label">{section ?? 'World Car Carrosserie'}</p>
    <h1>{title}</h1>
    <p>Cette page est en cours de construction.</p>
    <a href="/">← Retour à l’accueil</a>
  </main>
  <SiteFooter />
</Base>

<style>
  .stub { min-height: 70vh; display: grid; align-content: center; justify-items: start; gap: 14px; padding: 80px var(--pad); max-width: var(--max); margin: 0 auto; }
  h1 { margin: 0; font: 800 clamp(2.6rem, 8vw, 6rem) / 0.9 var(--f-display); text-transform: uppercase; }
  .label { margin: 0; color: var(--mute); }
  p { margin: 0; color: var(--mute); }
  a { font-weight: 600; }
</style>
